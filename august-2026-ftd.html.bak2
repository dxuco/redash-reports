":"fortune-7569621","c":"Luxembourg","g":"d","p":"Casino","h":"d","k":"","y":"c","a":23.31},{"u":"fortune-8607091","c":"Indonesia","g":"d","p":"Sport","h":"d","k":"","y":"c","a":34.46},{"u":"fortune-4529962","c":"Romania","g":"d","p":"Casino","h":"d","k":"","y":"f","a":68.57},{"u":"jack-9185647","c":"Hungary","g":"d","p":"Casino","h":"d","k":"","y":"f","a":20.07},{"u":"jack-3447349","c":"Norway","g":"s","p":"Live Casino","h":"s","k":"Influence","y":"c","a":-17421.48},{"u":"jack-4510324","c":"Finland","g":"seo","p":"Casino","h":"a","k":"SEO","y":"c","a":-92.66},{"u":"jack-2962081","c":"Romania","g":"seo","p":"Not Real Bet","h":"a","k":"SEO","y":"c","a":0},{"u":"fortune-0750874","c":"Hungary","g":"d","p":"Sport","h":"d","k":"","y":"c","a":8.18},{"u":"jack-7944276","c":"Germany","g":"d","p":"Casino","h":"d","k":"","y":"f","a":393.17},{"u":"fortune-0258921","c":"Hungary","g":"s","p":"Casino","h":"s","k":"Influence","y":"c","a":24.86},{"u":"nguyenngoctu11","c":"Vietnam","g":"d","p":"Not Real Bet","h":"d","k":"","y":"c","a":0},{"u":"fortune-4082598","c":"US","g":"com","p":"Sport","h":"d","k":"Community","y":"c","a":8.61},{"u":"CFChooligan","c":"US","g":"com","p":"Sport","h":"d","k":"Community","y":"c","a":-1.02},{"u":"jack-9259701","c":"Netherlands","g":"d","p":"Casino","h":"d","k":"","y":"f","a":20.06},{"u":"jack-4604394","c":"Brazil","g":"seo","p":"Sport","h":"a","k":"SEO","y":"f","a":1.66},{"u":"jack-0375764","c":"Ethiopia","g":"seo","p":"Sport","h":"a","k":"SEO","y":"c","a":-40.73},{"u":"jack-0979799","c":"Sweden","g":"s","p":"Casino","h":"s","k":"Influence","y":"f","a":27.04},{"u":"jack-9673703","c":"US","g":"com","p":"Sport","h":"d","k":"Community","y":"c","a":-20.16},{"u":"fortune-6956040","c":"Sweden","g":"s","p":"Casino","h":"s","k":"Influence","y":"f","a":57.15},{"u":"jack-7890198","c":"Ethiopia","g":"seo","p":"Sport","h":"a","k":"SEO","y":"c","a":0},{"u":"jack-7059528","c":"Brazil","g":"d","p":"Casino","h":"d","k":"Metamedia","y":"f","a":1.61},{"u":"fortune-2643434","c":"Brazil","g":"d","p":"Not Real Bet","h":"d","k":"","y":"f","a":0}];
(function(){
  const CH_LAB={s:'Streamer',a:'Affiliate',seo:'SEO',d:'Direct',com:'Community',all:'All'};
  const CH_COL={s:'#0B6E3A',a:'#0F2A43',seo:'#4E9D5C',d:'#677181',com:'#C0392B'};
  const BC=['#081E33','#0F2A43','#4A6480','#A8BAC9','#C3CCD4','#F2C48E','#ECA255','#E67E22','#A85410'];
  const LBL=['&lt; -$1k','-$1k..-250','-$250..-50','-$50..0','$0','$0..50','$50..250','$250..1k','&gt; $1k'];
  const fN=n=>Math.round(n).toLocaleString('en-US');
  const fG=n=>{n=Math.round(n);return (n<0?'-$':'$')+Math.abs(n).toLocaleString('en-US');};
  const el=document.getElementById('wlChart'),tip=document.getElementById('wlTip');
  let metric='n';
  function tiles(t){const net=t.g;
    document.getElementById('wlTiles').innerHTML=
     '<div class="kpi"><div class="k">Players Ahead</div><div class="v" style="color:#0F2A43">'+fN(t.negN)+'</div><div class="s">won '+fG(-t.negG)+' from the house</div></div>'+
     '<div class="kpi"><div class="k">Players Behind</div><div class="v" style="color:#E67E22">'+fN(t.posN)+'</div><div class="s">lost '+fG(t.posG)+' to the house</div></div>'+
     '<div class="kpi"><div class="k">Middle Class &middot; &plusmn;$50</div><div class="v" style="color:#677181">'+fN(t.midN)+'</div><div class="s">'+(t.n?(t.midN/t.n*100).toFixed(0):'0')+'% of FTDs &middot; net '+fG(t.midG)+'</div></div>'+
     '<div class="kpi"><div class="k">Net Adj GGR</div><div class="v" style="color:'+(net>=0?'#E67E22':'#0F2A43')+'">'+fG(net)+'</div><div class="s">house '+(net>=0?'up':'down')+' overall</div></div>';}
  function board(id,rows,pole){const mx=Math.max(1,...rows.map(r=>Math.abs(r.a)));
    document.getElementById(id).innerHTML=rows.map((r,i)=>{const w=Math.abs(r.a)/mx*100;
      return '<tr><td style="color:var(--mut);width:16px">'+(i+1)+'</td>'+
        '<td style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+r.u+'</td>'+
        '<td style="color:var(--mut)">'+r.c+'</td>'+
        '<td><span class="wlch" style="background:'+CH_COL[r.ch]+'">'+(CH_LAB[r.ch]||r.ch)+'</span></td>'+
        '<td style="width:38%"><span class="wlbar" style="width:'+w.toFixed(0)+'%;background:'+pole+'"></span></td>'+
        '<td style="text-align:right;font-weight:700;color:'+pole+'">'+fG(r.a)+'</td></tr>';}).join('');}
  function chart(d){const bands=d.bands;const n=9;
    const vals=bands.map(b=>metric==='n'?b[0]:Math.abs(b[1]));
    const W=760,H=250,pL=44,pR=14,pT=14,pB=54,pw=W-pL-pR,ph=H-pT-pB;
    const mx=Math.max(1,...vals)*1.16,bw=pw/n*0.72,gap=pw/n;
    const X=i=>pL+i*gap+(gap-bw)/2,Y=v=>pT+(1-v/mx)*ph;
    let grid='';for(let t=0;t<=2;t++){const gy=pT+t/2*ph;grid+='<line x1='+pL+' y1='+gy.toFixed(1)+' x2='+(W-pR)+' y2='+gy.toFixed(1)+' stroke="var(--line)" stroke-width="1"/><text x='+(pL-6)+' y='+(gy+3).toFixed(1)+' text-anchor="end" font-size="9" fill="var(--mut)">'+(metric==='n'?fN(mx/1.16*(1-t/2)):fG(mx/1.16*(1-t/2)))+'</text>';}
    let bars='';for(let i=0;i<n;i++){const bh=(vals[i]/mx)*ph,by=Y(vals[i]);
      bars+='<rect x='+X(i).toFixed(1)+' y='+by.toFixed(1)+' width='+bw.toFixed(1)+' height='+Math.max(0,bh).toFixed(1)+' rx="3" fill="'+BC[i]+'" data-i='+i+' style="cursor:pointer"/>';
      if(vals[i]>0)bars+='<text x='+(X(i)+bw/2).toFixed(1)+' y='+(by-4).toFixed(1)+' text-anchor="middle" font-size="9.5" font-weight="700" fill="'+BC[i]+'">'+(metric==='n'?fN(vals[i]):fG(bands[i][1]))+'</text>';
      /* How many players make up the bar, above the money. A band of one
         whale and a band of four hundred small losers draw the same height,
         and the money label alone cannot tell them apart. Only in the money
         view — in the player view the bar already is the count. */
      if(vals[i]>0&&metric!=='n'&&bands[i][0])bars+='<text x='+(X(i)+bw/2).toFixed(1)+' y='+(by-15).toFixed(1)+' text-anchor="middle" font-size="8.5" fill="var(--mut)">'+fN(bands[i][0])+' players</text>';
      bars+='<text x='+(X(i)+bw/2).toFixed(1)+' y='+(pT+ph+13)+' text-anchor="middle" font-size="8.5" fill="var(--ink2)">'+LBL[i]+'</text>';}
    const cx=pL+4.5*gap;
    const caps='<text x='+(pL+2.2*gap).toFixed(1)+' y='+(H-6)+' text-anchor="middle" font-size="10" font-weight="700" fill="#0F2A43">&#9664; players won</text>'+
      '<text x='+(pL+6.6*gap).toFixed(1)+' y='+(H-6)+' text-anchor="middle" font-size="10" font-weight="700" fill="#E67E22">players lost &#9654;</text>'+
      '<line x1='+cx.toFixed(1)+' y1='+pT+' x2='+cx.toFixed(1)+' y2='+(pT+ph)+' stroke="var(--mut)" stroke-width="1" stroke-dasharray="2,3" opacity="0.5"/>';
    el.innerHTML='<svg viewBox="0 0 '+W+' '+H+'" width="100%" style="display:block;overflow:visible">'+grid+bars+caps+'</svg>';
    el.querySelectorAll('rect').forEach(rc=>{rc.addEventListener('mousemove',e=>{const i=+rc.getAttribute('data-i');const r=el.getBoundingClientRect();
      tip.style.display='';tip.style.left=(e.clientX-r.left)+'px';tip.style.top=(e.clientY-r.top-38)+'px';
      tip.innerHTML=LBL[i].replace(/&lt;/g,'<').replace(/&gt;/g,'>')+' &middot; <b>'+fN(bands[i][0])+'</b> players &middot; '+fG(bands[i][1]);});
      rc.addEventListener('mouseleave',()=>tip.style.display='none');});}
  function bandIdx(a){if(a<-1000)return 0;if(a<-250)return 1;if(a<-50)return 2;if(a<0)return 3;if(a===0)return 4;if(a<=50)return 5;if(a<=250)return 6;if(a<=1000)return 7;return 8;}
  function derive(rows){const bands=[];for(let i=0;i<9;i++)bands.push([0,0]);
    let g=0,posN=0,posG=0,negN=0,negG=0,midN=0,midG=0;
    rows.forEach(r=>{const a=r.a;const b=bands[bandIdx(a)];b[0]++;b[1]+=a;g+=a;
      if(a>0){posN++;posG+=a;}else if(a<0){negN++;negG+=a;}
      if(Math.abs(a)<=50){midN++;midG+=a;}});
    const srt=rows.slice().sort((x,y)=>x.a-y.a);
    const loss=srt.filter(r=>r.a<0).slice(0,12);
    const win=srt.filter(r=>r.a>0).reverse().slice(0,12);
    return {bands:bands,loss:loss,win:win,
      tot:{n:rows.length,g:g,posN:posN,posG:posG,negN:negN,negG:negG,midN:midN,midG:midG}};}
  function current(){return WLP.filter(r=>(curCh==='all'||r.g===curCh)&&(curP==='all'||r.p===curP)&&gfRow(r.h,r.k,r.y,r.p));}
  let curCh='all',curP='all',curD=null;
  window.__gfHooks.push(render);
  function render(){curD=derive(current());tiles(curD.tot);board('wlLoss',curD.loss,'#0F2A43');board('wlWin',curD.win,'#E67E22');chart(curD);
    const sub=document.getElementById('wlScope');
    if(sub){const parts=[];if(curCh!=='all')parts.push(CH_LAB[curCh]);if(curP!=='all')parts.push(curP);
      sub.textContent=parts.length?parts.join(' \u00b7 ')+' \u00b7 '+curD.tot.n+' players':curD.tot.n+' players';}}
  document.querySelectorAll('#wlSwitch .wlb').forEach(b=>b.onclick=()=>{document.querySelectorAll('#wlSwitch .wlb').forEach(x=>x.classList.remove('on'));b.classList.add('on');curCh=b.getAttribute('data-ch');render();});
  document.querySelectorAll('#wlProd .wlp').forEach(b=>b.onclick=()=>{document.querySelectorAll('#wlProd .wlp').forEach(x=>x.classList.remove('on'));b.classList.add('on');curP=b.getAttribute('data-p');render();});
  document.querySelectorAll('#wlMetric .wlm').forEach(b=>b.onclick=()=>{document.querySelectorAll('#wlMetric .wlm').forEach(x=>x.classList.remove('on'));b.classList.add('on');metric=b.getAttribute('data-m');chart(curD);});
  render();
})();
</script>
<footer><span>August 2026 · FTD cohort (first deposit in August) · query 1732 · month-to-date, days 1–25</span><span id="fRows"></span></footer>
</div>
