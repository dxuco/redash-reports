      out[r[1]]=(out[r[1]]||0)+r[5];}
    return out;}
  /* Null, not {}, when the period never measured clicks — val5 shows a dash for
     null and a zero for {}, and "we never counted" is not "nobody clicked". */
  function clkOf(per,D){if(!D)return APC[per];
    const rows=APCD[per];if(!rows)return null;
    const out={};
    for(let i=0;i<rows.length;i++){const r=rows[i];if(r[0]!==D)continue;out[r[1]]=(out[r[1]]||0)+r[2];}
    return out;}
  window.__gfHooks.push(render);
  window.__dayHooks.push(render);
  function render(){
    const D=apDay();
    const cur=aggregate(APP.cur,D),pm=aggregate(APP.pm,D),py=aggregate(APP.py,D);
    const rc=D?regDayOf('cur',D):regOf('cur'),rp=D?regDayOf('pm',D):regOf('pm'),ry=D?regDayOf('py',D):regOf('py');
    const hide=(apPr!=='all'||apRl!=='all'||gfNoReg());
    const P3={cur:[rc,cur],pm:[rp,pm],py:[ry,py]};
    const CK={cur:clkOf('cur',D),pm:clkOf('pm',D),py:clkOf('py',D)};
    const mOf=(pair,c,m,per)=>{if(m==='clk'){const o=CK[per||'cur'];return o?(o[c]||0):0;}
      if(m==='c2r'){const o=CK[per||'cur'],cl=o?o[c]:0;return cl?(pair[0][c]||0)/cl*100:0;}
      if(m==='reg')return pair[0][c]||0;const v=pair[1][c]||[0,0,0,0];
      if(m==='r2d'){const r=pair[0][c]||0;return r?v[0]/r*100:0;}
      return m==='f'?v[0]:m==='sq'?v[1]:m==='avg'?avg(v):v[2];};
    const chg=(a,b)=>b?(a-b)/Math.abs(b)*100:-Infinity;
    let sk=apSort.k;
    if(hide&&sk.split('.')[1]==='reg')sk='cur.f';
    const sv=c=>{const q=sk.split('.'),g=q[0],m=q[1];
      if(g==='mom')return chg(mOf(P3.cur,c,m,'cur'),mOf(P3.pm,c,m,'pm'));
      if(g==='yoy')return chg(mOf(P3.cur,c,m,'cur'),mOf(P3.py,c,m,'py'));
      if(g==='d')return mOf(P3.cur,c,'f')-mOf(m==='dmom'?P3.pm:P3.py,c,'f');
      return mOf(P3[g],c,m,g);};
    const cand=[...new Set([...Object.keys(cur),...Object.keys(pm),...Object.keys(py),
      ...(hide?[]:[...Object.keys(rc),...Object.keys(rp),...Object.keys(ry)])])];
    const top=cand.sort((x,y)=>{const a=sv(x),b=sv(y);
      return a===b?(x<y?-1:1):(a-b)*apSort.dir;}).slice(0,30);
    document.querySelectorAll('th.aph').forEach(th=>th.classList.toggle('sorted',th.dataset.sk===sk));
    document.getElementById('apBody').innerHTML=top.length?top.map(c=>'<tr><td class="l" title="'+c.replace(/"/g,'&quot;')+'">'+c+'</td>'+val5(rc,cur,c,hide,CK.cur)+val5(rp,pm,c,hide,CK.pm)+pct5(rc,rp,cur,pm,c,hide,'mom')+val5(ry,py,c,hide,CK.py)+pct5(rc,ry,cur,py,c,hide,'yoy')+del2(cur,pm,py,c)+'</tr>').join('')
      :'<tr><td class="l" colspan="37" style="color:var(--mut);padding:16px 12px">No FTDs for this selection.</td></tr>';
    const alln=new Set([...Object.keys(cur),...Object.keys(pm),...Object.keys(py)]);
    const sum=m=>{let t=[0,0,0,0];alln.forEach(c=>{const v=m[c]||[0,0,0,0];t[0]+=v[0];t[1]+=v[1];t[2]+=v[2];t[3]+=v[3];});return t;};
    const T={t:sum(cur)},P={t:sum(pm)},Y={t:sum(py)};
    const rsum=m=>{let n=0;Object.keys(m).forEach(k=>n+=m[k]);return n;};
    const RC={t:rsum(rc)},RP={t:rsum(rp)},RY={t:rsum(ry)};
    const csum=o=>{if(!o)return null;let n=0;Object.keys(o).forEach(k=>n+=o[k]);return {t:n};};
    const ACT={cur:csum(CK.cur),pm:csum(CK.pm),py:csum(CK.py)};
    document.getElementById('apFoot').innerHTML='<tr style="font-weight:700;border-top:2px solid #C3CCD4"><td class="l"><b>Total</b></td>'+val5(RC,T,'t',hide,ACT.cur)+val5(RP,P,'t',hide,ACT.pm)+pct5(RC,RP,T,P,'t',hide,'mom')+val5(RY,Y,'t',hide,ACT.py)+pct5(RC,RY,T,Y,'t',hide,'yoy')+del2(T,P,Y,'t')+'</tr>';
    const sc=document.getElementById('apScope');
    if(sc){const parts=[];
      if(D)parts.push('day '+Number(D)+' of each period');
      if(apCh.size)parts.push([...apCh].map(g=>LAB[g]).join(' + '));
      if(apPr!=='all')parts.push(apPr);
      if(apRl!=='all')parts.push(RLAB[apRl]);
      sc.textContent=(parts.length?parts.join(' \u00b7 ')+' \u00b7 ':'')+T.t[0]+' FTDs \u00b7 '+alln.size+' partners';}
    /* The standing caption promises month-to-date, which stops being true the
       moment a day is picked. Left as written in the markup when it is. */
    const cap=document.getElementById('apPeriodNote');
    if(cap)cap.textContent=D?'day '+Number(D)+' of each period':'all periods month-to-date (days 1\u201323)';
  }
  function paintCh(){document.querySelectorAll('#apSwitch .apbtn').forEach(function(x){
    const k=x.dataset.ch;x.classList.toggle('on',k==='all'?apCh.size===0:apCh.has(k));});}
  document.querySelectorAll('#apSwitch .apbtn').forEach(b=>b.onclick=()=>{
    const k=b.dataset.ch;
    if(k==='all')apCh.clear();
    else if(apCh.has(k))apCh.delete(k);else apCh.add(k);
    paintCh();render();});
  document.querySelectorAll('#apProd .app').forEach(b=>b.onclick=()=>{
    document.querySelectorAll('#apProd .app').forEach(x=>x.classList.remove('on'));
    b.classList.add('on');apPr=b.dataset.p;render();});
  document.querySelectorAll('#apRail .app').forEach(b=>b.onclick=()=>{
    document.querySelectorAll('#apRail .app').forEach(x=>x.classList.remove('on'));
    b.classList.add('on');apRl=b.dataset.y;render();});
  document.querySelectorAll('th.aph').forEach(th=>th.onclick=()=>{
    const k=th.dataset.sk;
    apSort.dir=apSort.k===k?-apSort.dir:-1;apSort.k=k;render();});

  /* Collapse a comparison block. The group header survives as a one-cell stub
     with a + so it can be brought back, and its colspan drops to 1 so both
     header rows stay aligned with the body. Hiding is by class on the table, so
     it survives the re-render that every filter change triggers. */
  (function(){
    const tbl=document.getElementById('apTbl');
    if(!tbl)return;
    tbl.querySelectorAll('th.grp').forEach(function(th){
      const g=th.dataset.g, span=+th.dataset.span;
      const btn=document.createElement('button');
      btn.className='colTog';btn.textContent='−';
      btn.setAttribute('aria-label','hide '+g+' columns');
      btn.onclick=function(e){e.stopPropagation();
        const off=tbl.classList.toggle('no'+g);
        th.colSpan=off?1:span;
        btn.textContent=off?'+':'−';
        btn.setAttribute('aria-label',(off?'show ':'hide ')+g+' columns');
        const lab=th.querySelector('.grplab');if(lab)lab.style.display=off?'none':'';};
      th.appendChild(btn);});
  })();
  render();
})();
</script>
<div class="sec"><div class="sec-head"><div><span class="sec-title"><span class="sec-num">07</span>Depositors</span></div>
  <div class="sec-sub" id="topSub">Highest August first-time deposits · MTD figures are month-to-date totals · follows the day/country filters</div></div>
  <div class="tblwrap"><div class="tblscroll" style="max-height:640px"><table id="topTbl"><thead><tr>
    <th class="l rank">#</th><th class="l" data-k="u">Player<span class="ar">▾</span></th><th class="l" data-k="c">Country<span class="ar">▾</span></th><th class="l" data-k="aff">Partner<span class="ar">▾</span></th>
    <th class="l" data-k="blk">Status<span class="ar">▾</span></th>
    <th class="l" data-k="fd">FTD Date<span class="ar">▾</span></th>
    <th class="l" data-k="last">Last Active<span class="ar">▾</span></th>
    <th data-k="ftd">FTD Amount<span class="ar">▾</span></th>
    <th data-k="dep">MTD Deposit<span class="ar">▾</span></th><th data-k="adj">MTD Adj GGR<span class="ar">▾</span></th>
    <th data-k="ngr">MTD NGR<span class="ar">▾</span></th><th data-k="bonus">MTD Bonus<span class="ar">▾</span></th><th data-k="ratio">Bonus/AdjGGR<span class="ar">▾</span></th>
  </tr></thead><tbody id="topBody"></tbody><tfoot id="topFoot"></tfoot></table></div></div></div>

