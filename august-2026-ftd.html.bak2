(function(){
  const SEP='border-left:2px solid #D8DEE0;';
  const fN=n=>Math.round(n).toLocaleString('en-US');
  const fG=n=>{n=Math.round(n);return (n<0?'-':'')+'$'+Math.abs(n).toLocaleString('en-US');};
  const fK=n=>{n=Math.round(n);const s=n<0?'-':'',a=Math.abs(n);
    if(a>=1000000)return s+'$'+(a/1000000).toFixed(a>=10000000?0:1).replace(/\.0$/,'')+'M';
    if(a>=1000)return s+'$'+(a/1000).toFixed(a>=100000?0:1).replace(/\.0$/,'')+'K';
    return s+'$'+a.toLocaleString('en-US');};
  const avg=v=>v[0]?v[3]/v[0]:0;
  const DASH='<span class="zero">\u2014</span>';
  const pct=(c,p)=>{if(!p)return DASH;const v=Math.round((c-p)/Math.abs(p)*100);
    const cls=v>=0?'pos':'neg';const a=Math.abs(v);
