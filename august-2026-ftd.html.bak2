  const apDay=()=>(window.__selDayOf&&window.__selDayOf())||null;
  const LAB={s:'Streamer',a:'Affiliate',seo:'SEO',d:'Direct',com:'Community'};
  const RLAB={c:'Crypto',f:'Fiat'};
  function aggregate(list,D){const m={};
    list.forEach(function(r){
      if(D&&r.d!==D)return;
