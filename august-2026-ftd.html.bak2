:2,"sq":0,"cr":2,"fi":0,"r2d":null,"m":40.798867079541246,"avg":20.399433539770623,"med":20.399433539770623,"dep":40.798867079541246,"bet":123.65255507360696,"adj":40.77770049805577,"bonus":0,"ngr":40.77770049805577,"edge":32.97764488067548,"bongr":0,"retp":null,"blkp":0,"one":2,"onep":100,"oneb":0},"@PPC|c|Sport":{"reg":null,"f":1,"sq":1,"cr":1,"fi":0,"r2d":null,"m":60.01185025178499,"avg":60.01185025178499,"med":60.01185025178499,"dep":697.741620028687,"bet":1087.046818367806,"adj":364.99395318383995,"bonus":0,"ngr":364.99395318383995,"edge":33.576654382915734,"bongr":0,"retp":100,"blkp":100,"one":0,"onep":0,"oneb":0}}};
  /* label, key, format, and whether a rise is the good direction (unused for
     colour -- these are neutral movements, not scores -- but kept so the sign
     convention is explicit) */
  const ROWS={
    scAcq:[['Registrations','reg','N'],['FTD Count','f','N'],['Crypto FTDs','cr','N'],['Fiat FTDs','fi','N'],['SQ FTD','sq','N'],['Reg2Dep','r2d','P']],
    scFin:[['FTD Amount','m','M'],['Avg FTD','avg','M'],['Median FTD','med','M'],
           ['Total Deposits','dep','M'],['Total Bet','bet','M'],['Adj GGR','adj','M'],
           ['Bonus Cost','bonus','M'],['NGR','ngr','M'],['House Edge','edge','P'],
           ['Bonus / GGR','bongr','P']],
    scRet:[['7D Retention','retp','P'],['Blocked','blkp','P'],['One-Time FTDs','one','N'],
           ['One-Time Share','onep','P'],['Bonus \u00b7 One-Time','oneb','M']]
  };
  const gk=()=>{var b=window.__dcSrc?('@'+window.__dcSrc):(window.__dcCh||'');var r=window.__dcRail||'',f=window.__dcFav||'';return (r||f)?b+'|'+r+'|'+f:b;};
  const DASH='<span class="zero">\u2014</span>';
  function fmt(v,f){
    if(v==null)return DASH;
    if(f==='N')return fmtN(v);
    if(f==='P')return fmtP(v);
    return fmtM(v);
  }
  function delta(a,b,f){
    if(a==null||b==null)return DASH;
    if(f==='P'){const d=a-b;return '<span class="'+(d>=0?'scup':'scdn')+'">'+ppW(d)+'</span>';}
    if(!b)return DASH;
    const d=(a-b)/Math.abs(b)*100;
    return '<span class="'+(d>=0?'scup':'scdn')+'">'+(d>=0?'+':'')+Math.round(d)+'%</span>';
  }
  function live(){
    /* the current column follows every filter, including a clicked day or
       country, so it is derived here rather than read from SCORE */
    const t=totals(filt()), pl=kpiPlayers();
    const reg=regTotal(x=>(!selDay||x.d===selDay)&&(!selCtry||x.c===selCtry));
    const ones=pl.filter(r=>(r.dc||0)<=1);
    const med=medianOf(pl.map(r=>r.ftd));
    const noreg=window.gfNoReg&&window.gfNoReg();
    return {reg:noreg?null:reg,f:t.f,sq:t.sq,cr:t.cr,fi:t.fi,r2d:(noreg||!reg)?null:t.f/reg*100,
      m:t.m,avg:t.f?t.avg:null,med:pl.length?med:null,
      dep:t.dep,bet:t.bet,adj:t.adj,bonus:t.bonus,ngr:t.ngr,
      edge:t.bet?t.adj/t.bet*100:null,bongr:t.adj>0?t.bonus/t.adj*100:null,
      retp:t.retp,blkp:t.f?t.blk/t.f*100:null,
      one:ones.length,onep:pl.length?ones.length/pl.length*100:null,
      oneb:ones.reduce((a,r)=>a+(r.bonus||0),0)};
  }
  window.renderScore=function(){
    const k=gk(), C=live();
    /* a day/country/partner selection has no counterpart in the stored
       comparison periods, so those two columns stand down rather than compare
       one slice of August against the whole of July */
    /* Rail and product have their own comparison sets now; day, country and
   affiliate are unbounded and still stand the columns down. */
    const narrowed=!!(selDay||selCtry||selAff);
    const P=narrowed?null:(SCORE.pm[k]||null), Y=narrowed?null:(SCORE.py[k]||null);
    Object.keys(ROWS).forEach(function(id){
      const el=document.getElementById(id);if(!el)return;
      el.innerHTML='<thead><tr><th class="l">Metric</th><th>Aug 2026</th><th>Jul 2026</th>'+
        '<th>vs PM</th><th>Aug 2025</th><th>vs PY</th></tr></thead><tbody>'+
        ROWS[id].map(function(r){
          const key=r[1],f=r[2];
          const c=C[key], p=P?P[key]:null, y=Y?Y[key]:null;
          return '<tr><td class="l">'+r[0]+'</td><td class="cur">'+fmt(c,f)+'</td>'+
            '<td class="dim">'+fmt(p,f)+'</td><td>'+delta(c,p,f)+'</td>'+
            '<td class="dim">'+fmt(y,f)+'</td><td>'+delta(c,y,f)+'</td></tr>';
        }).join('')+'</tbody>';
    });
  };
})();
</script></div>


<div class="sec"><div class="sec-head"><div><span class="sec-title"><span class="sec-num">02</span>Last 30D Trend</span></div></div><div class="sec-sub">27 Jul &ndash; 25 Aug 2026</div><style>.dailyCharts{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:14px}@media(max-width:900px){.dailyCharts{grid-template-columns:1fr}}.dchart{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:9px 12px 4px}.dchart-hd{font-size:12px;color:var(--mut);font-weight:600;margin-bottom:2px}.dchart-hd b{color:var(--ink);font-weight:700}.dchart-tip{pointer-events:none;background:var(--ink);color:#fff;font-size:11px;padding:3px 7px;border-radius:5px;white-space:nowrap;transform:translate(-50%,-150%);z-index:5;font-weight:600}#dcSwitch{display:flex;gap:6px;margin-top:14px}#dcSrcSwitch{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}#dcSwitch .dcbtn,#dcSrcSwitch .dcbtn{padding:3px 12px;border:1px solid #C3CCD4;background:#fff;border-radius:6px;cursor:pointer;font-family:inherit;font-size:12px;font-weight:600;color:#5B7285}#dcSwitch .dcbtn.on,#dcSrcSwitch .dcbtn.on{background:#0B6E3A;color:#fff;border-color:#0B6E3A}</style><div class="dailyCharts" id="dailyCharts"></div></div>
<div class="sec"><div class="sec-head"><div><span class="sec-title"><span class="sec-num">03</span>Daily FTDs</span></div><div class="sec-sub" id="s1sub"></div></div><div class="strip" id="strip" style="margin-top:14px"></div><div class="tblwrap" style="margin-top:14px"><table id="dailyTbl"><thead><tr><th class="l" data-k="fd">FTD Date<span class="ar">▾</span></th><th data-k="reg">Reg<span class="ar">▾</span></th><th data-k="f">FTD<span class="ar">▾</span></th><th data-k="sq">SQ FTD<span class="ar">▾</span></th><th data-k="reg2dep">Reg2Dep<span class="ar">▾</span></th>
    <th data-k="m">FTD Amount<span class="ar">▾</span></th><th data-k="avg">Avg FTD<span class="ar">▾</span></th>
    <th data-k="dep">MTD Deposit<span class="ar">▾</span></th><th data-k="ngr">MTD NGR<span class="ar">▾</span></th><th data-k="adj">Adj GGR<span class="ar">▾</span></th><th data-k="bonus">Bonus Cost<span class="ar">▾</span></th><th data-k="cr">Crypto<span class="ar">▾</span></th><th data-k="fi">Fiat<span class="ar">▾</span></th></tr></thead><tbody id="dailyBody"></tbody><tfoot id="dailyFoot"></tfoot></table></div></div>
<div class="sec"><div class="sec-head"><div><span class="sec-title"><span class="sec-num">04</span>Source Movement &mdash; vs Prior Month</span></div><div class="sec-sub" id="momScope"></div></div>
<style>
#momWrap{margin-top:2px}
#momHero{display:flex;align-items:baseline;gap:10px;margin:2px 0 16px}
#momHero .n{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:30px;font-weight:700;letter-spacing:-.02em}
#momHero .c{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;color:var(--mut)}
#momTbl{width:100%;border-collapse:collapse;font-size:12px}
#momTbl th{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:9px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--mut);font-weight:600;text-align:right;padding:0 8px 7px;border-bottom:1px solid var(--line)}
#momTbl th.l{text-align:left}
#momTbl td{padding:5px 8px;vertical-align:middle}
#momTbl td.l{font-weight:600;white-space:nowrap}
#momTbl td.n{text-align:right;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;white-space:nowrap}
#momTbl tfoot td{border-top:1px solid var(--ink);font-weight:700;padding-top:8px}
.mombar{position:relative;height:15px;min-width:210px}
.mombar .zero{position:absolute;top:-3px;bottom:-3px;width:1px;background:var(--line);left:50%}
.mombar .fill{position:absolute;top:0;height:15px}
.mombar .fill.neg{background:#E67E22;border-radius:4px 0 0 4px}
.mombar .fill.pos{background:#0F2A43;border-radius:0 4px 4px 0}
#momTbl tr.hov td{background:var(--sel)}
.momtip{position:fixed;pointer-events:none;background:var(--ink);color:#fff;font-size:11px;font-weight:600;
  padding:4px 8px;border-radius:5px;white-space:nowrap;z-index:60;display:none}
.momkey{display:flex;gap:16px;margin:0 0 10px;font-size:11px;color:var(--mut);align-items:center}
.momkey i{display:inline-block;width:11px;height:11px;border-radius:3px;margin-right:5px;vertical-align:-1px}
</style>
<div id="momWrap">
  <div id="momHero"></div>
  <div class="momkey"><span><i style="background:#E67E22"></i>lost vs prior month</span><span><i style="background:#0F2A43"></i>gained</span></div>
  <div class="tblwrap"><table id="momTbl"><thead><tr><th class="l">Source</th><th class="l" style="text-align:center">&#9664; lost &middot; gained &#9654;</th><th>Change</th><th>Prior Month</th><th>Current</th><th>%</th></tr></thead><tbody id="momBody"></tbody><tfoot id="momFoot"></tfoot></table></div>
</div>
<div class="momtip" id="momTip"></div>
<script>
(function(){
  const MOM=[["s","Influence","c","Casino",255,329],["d","","c","Live Casino",45,58],["d","","f","Casino",58,64],["d","","c","Sport",70,147],["a","Meta","f","Casino",6,2],["s","Influence","c","Crash",28,33],["s","Influence","c","Live Casino",109,162],["d","Community","c","Casino",12,14],["s","Influence","f","Casino",28,47],["a","SEO","f","Casino",46,52],["d","Community","c","Provably Fair",4,6],["d","Metamedia","f","Casino",18,4],["d","","c","Casino",89,112],["d","Community","c","Crash",3,2],["d","","f","Sport",11,18],["s","KOl","c","Casino",15,11],["s","Influence","c","Provably Fair",39,45],["d","","c","Provably Fair",23,20],["a","SEO","c","Casino",40,41],["a","Meta","f","Provably Fair",1,0],["d","","c","Crash",17,21],["d","Metamedia","f","Live Casino",1,2],["d","","f","Crash",4,6],["s","Influence","c","Not Real Bet",6,4],["s","Influence","c","Sport",26,72],["a","SEO","f","Live Casino",7,3],["d","Community","c","Dice",1,0],["d","","f","Provably Fair",2,1],["d","","f","Not Real Bet",5,1],["a","SEO","f","Provably Fair",1,0],["a","SEO","c","Live Casino",10,7],["a","SEO","f","Sport",18,2],["a","SEO","c","Not Real Bet",2,0],["d","Metamedia","f","Crash",2,0],["d","","f","Live Casino",10,15],["a","Tipster","f","Sport",2,2],["a","SEO","f","Not Real Bet",3,1],["a","SEO","c","Sport",26,10],["s","KOl","c","Live Casino",2,0],["d","","c","Not Real Bet",8,10],["d","","c","Dice",1,1],["d","Metamedia","c","Sport",1,3],["s","Influence","f","Live Casino",6,6],["d","Community","f","Casino",1,1],["d","Metamedia","f","Not Real Bet",1,0],["s","Influence","c","Dice",23,0],["a","SEO","c","Provably Fair",7,1],["a","","c","Casino",2,0],["d","Community","c","Live Casino",1,1],["d","Community","c","Sport",5,28],["d","Metamedia","c","Live Casino",1,8],["s","Influence","f","Provably Fair",1,0],["a","SEO","f","Crash",3,1],["a","Tipster","f","Not Real Bet",1,0],["d","Metamedia","c","Casino",5,14],["a","Meta","c","Casino",6,0],["a","Meta","f","Crash",1,0],["d","Metamedia","c","Crash",1,5],["a","Meta","c","Sport",1,0],["a","Meta","c","Provably Fair",1,0],["d","Metamedia","f","Sport",1,3],["a","Tipster","c","Sport",0,3],["a","SEO","c","Crash",0,3],["a","Tipster","c","Live Casino",0,1],["s","Influence","f","Sport",0,3],["d","","c","Micro Betting",0,1],["d","Community","c","Not Real Bet",0,1]], MLAB={"":"Direct (untagged)"};
  const $m=id=>document.getElementById(id);
  const fN=n=>Math.round(n).toLocaleString('en-US');
  const sg=n=>(n>0?'+':'')+fN(n);
  function rows(){
    const m={};
    MOM.forEach(function(r){
      if(window.gfRow&&!window.gfRow(r[0],r[1],r[2],r[3]))return;
      const k=MLAB[r[1]]||r[1];
      let v=m[k];if(!v)v=m[k]=[0,0];
      v[0]+=r[4];v[1]+=r[5];});
    return Object.keys(m).map(k=>({k:k,cur:m[k][0],pm:m[k][1],d:m[k][0]-m[k][1]}))
      .sort((x,y)=>x.d-y.d);
  }
  function render(){
    const rs=rows();
    const tc=rs.reduce((a,r)=>a+r.cur,0), tp=rs.reduce((a,r)=>a+r.pm,0), td=tc-tp;
    const mx=Math.max(1,...rs.map(r=>Math.abs(r.d)));
    $m('momHero').innerHTML='<span class="n" style="color:'+(td<0?'#E67E22':'#0F2A43')+'">'+sg(td)+
      ' FTDs</span><span class="c">vs prior month, same days &middot; '+fN(tp)+' &rarr; '+fN(tc)+
      (tp?' &middot; '+sg(Math.round(td/tp*100))+'%':'')+'</span>';
    const sc=$m('momScope');
    if(sc)sc.textContent=sg(td)+' FTDs vs prior month';
    $m('momBody').innerHTML=rs.map(function(r){
      const w=Math.abs(r.d)/mx*50, neg=r.d<0;
      /* bar grows from the centre line: negatives left, positives right */
      const st=neg?('right:50%;width:'+w+'%'):('left:50%;width:'+w+'%');
      return '<tr data-k="'+r.k+'"><td class="l">'+r.k+'</td>'+
        '<td><div class="mombar"><div class="zero"></div>'+
        (r.d?'<div class="fill '+(neg?'neg':'pos')+'" style="'+st+'"></div>':'')+'</div></td>'+
        '<td class="n" style="font-weight:700;color:'+(neg?'#E67E22':(r.d?'#0F2A43':'var(--mut)'))+'">'+
        (r.d?sg(r.d):'&mdash;')+'</td>'+
        '<td class="n">'+fN(r.pm)+'</td><td class="n">'+fN(r.cur)+'</td>'+
        '<td class="n" style="color:var(--mut)">'+(r.pm?sg(Math.round(r.d/r.pm*100))+'%':'new')+'</td></tr>';
    }).join('');
    $m('momFoot').innerHTML='<tr><td class="l">Total</td><td></td>'+
      '<td class="n" style="color:'+(td<0?'#E67E22':'#0F2A43')+'">'+sg(td)+'</td>'+
      '<td class="n">'+fN(tp)+'</td><td class="n">'+fN(tc)+'</td>'+
      '<td class="n">'+(tp?sg(Math.round(td/tp*100))+'%':'&mdash;')+'</td></tr>';
    const tip=$m('momTip');
    $m('momBody').querySelectorAll('tr').forEach(function(tr){
      const r=rs.find(x=>x.k===tr.dataset.k);
      tr.onmousemove=function(e){
        tr.classList.add('hov');tip.style.display='block';
        tip.textContent=r.k+' \u00b7 '+fN(r.pm)+' \u2192 '+fN(r.cur)+' ('+sg(r.d)+')';
        tip.style.left=(e.clientX+14)+'px';tip.style.top=(e.clientY-28)+'px';};
      tr.onmouseleave=function(){tr.classList.remove('hov');tip.style.display='none';};
    });
  }
  if(window.__gfHooks)window.__gfHooks.push(render);
  render();
})();
</script>
</div>
<div class="sec"><div class="sec-head"><div><span class="sec-title"><span class="sec-num">05</span>Country Performance &mdash; MoM &amp; YoY</span><span class="sec-sub" id="cpScope" style="margin-left:10px"></span></div></div><style>#cpSwitch .cpbtn{padding:4px 13px;border:1px solid #C3CCD4;background:#fff;border-radius:6px;cursor:pointer;font-family:inherit;font-size:12px;font-weight:600;color:#5B7285}#cpSwitch .cpbtn.on{background:#0B6E3A;color:#fff;border-color:#0B6E3A}#cpProd .cpp,#cpRail .cpp{padding:4px 13px;border:1px solid #C3CCD4;background:#fff;border-radius:6px;cursor:pointer;font-family:inherit;font-size:12px;font-weight:600;color:#5B7285}#cpProd .cpp.on{background:#4E9D5C;color:#fff;border-color:#4E9D5C}th.cph{cursor:pointer;user-select:none;white-space:nowrap}th.cph:hover{color:var(--ink)}th.cph .cpar{opacity:.2;font-size:7px;margin-left:1px}th.cph.sorted{color:var(--accent)}th.cph.sorted .cpar{opacity:1}table.nomom .gmom,table.noyoy .gyoy{display:none}th.grp .colTog{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10px;font-weight:700;line-height:1;width:14px;height:14px;padding:0;margin-left:5px;border:1px solid var(--line);border-radius:3px;background:var(--card);color:var(--mut);cursor:pointer;vertical-align:1px}th.grp .colTog:hover{border-color:var(--accent);color:var(--accent)}#cpRail .cpp.on{background:#E67E22;color:#fff;border-color:#E67E22}#cpRail .cpp[data-y="c"].on{background:#0B6E3A;border-color:#0B6E3A}</style><div class="tblwrap"><div class="cpscroll"><table style="font-size:12px" id="cpTbl"><thead><tr><th class="l" rowspan="2" style="vertical-align:bottom">Country</th><th colspan="6" style="border-left:2px solid #D8DEE0;text-align:center"><span class="grplab">Current Month &middot; Aug 2026</span></th><th colspan="6" style="border-left:2px solid #D8DEE0;text-align:center"><span class="grplab">Pr. Month &middot; Jul 2026</span></th><th class="grp" data-g="mom" data-span="5" colspan="5" style="border-left:2px solid #D8DEE0;text-align:center"><span class="grplab">vs Pr. Month %</span></th><th colspan="6" style="border-left:2px solid #D8DEE0;text-align:center"><span class="grplab">Pr. Year &middot; Aug 2025</span></th><th class="grp" data-g="yoy" data-span="5" colspan="5" style="border-left:2px solid #D8DEE0;text-align:center"><span class="grplab">vs Pr. Year %</span></th><th colspan="2" style="border-left:2px solid #D8DEE0;text-align:center"><span class="grplab">FTD Change</span></th></tr><tr><th class="cph" data-sk="cur.reg" style="border-left:2px solid #D8DEE0;text-align:right">Reg<span class="cpar">▾</span></th><th class="cph" data-sk="cur.f" style="text-align:right">FTD<span class="cpar">▾</span></th><th class="cph" data-sk="cur.r2d" style="text-align:right">R2D<span class="cpar">▾</span></th><th class="cph" data-sk="cur.sq" style="text-align:right">SQ<span class="cpar">▾</span></th><th class="cph" data-sk="cur.avg" style="text-align:right">Avg FTD<span class="cpar">▾</span></th><th class="cph" data-sk="cur.ggr" style="text-align:right">GGR<span class="cpar">▾</span></th><th class="cph" data-sk="pm.reg" style="border-left:2px solid #D8DEE0;text-align:right">Reg<span class="cpar">▾</span></th><th class="cph" data-sk="pm.f" style="text-align:right">FTD<span class="cpar">▾</span></th><th class="cph" data-sk="pm.r2d" style="text-align:right">R2D<span class="cpar">▾</span></th><th class="cph" data-sk="pm.sq" style="text-align:right">SQ<span class="cpar">▾</span></th><th class="cph" data-sk="pm.avg" style="text-align:right">Avg FTD<span class="cpar">▾</span></th><th class="cph" data-sk="pm.ggr" style="text-align:right">GGR<span class="cpar">▾</span></th><th class="cph gmom" data-sk="mom.reg" style="border-left:2px solid #D8DEE0;text-align:right">Reg<span class="cpar">▾</span></th><th class="cph gmom" data-sk="mom.f" style="text-align:right">FTD<span class="cpar">▾</span></th><th class="cph gmom" data-sk="mom.sq" style="text-align:right">SQ<span class="c