      if(apCh.size&&!apCh.has(r.g))return;
      if(apPr!=='all'&&r.p!==apPr)return;
      if(apRl!=='all'&&r.y!==apRl)return;
      let v=m[r.n];if(!v)v=m[r.n]=[0,0,0,0];v[0]+=1;v[1]+=r.s;v[2]+=r.a;v[3]+=r.m;});
