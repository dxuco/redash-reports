<!DOCTYPE html><html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>August FTD Performance — 2026</title>


<style>
:root{--ink:#0F2A43;--ink2:#5B7285;--mut:#677181;--line:#E5E5E5;--line2:#F3F7F3;--bg:#F4F6F5;--card:#FFFFFF;--accent:#0B6E3A;--accent-soft:#E3F3E8;--money:#E67E22;--stream:#0B6E3A;--aff:#0F2A43;--direct:#5B7285;--ret:#C0392B;--sq:#4E9D5C;--sel:#E3F3E8;--sel-line:#4E9D5C;--bar-bg:#EEF1F4;}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;-webkit-font-smoothing:antialiased;padding:0 0 60px}
.wrap{max-width:1800px;margin:0 auto;padding:20px 20px 0}
.cover{background:linear-gradient(135deg,var(--accent) 0%,#0a5a30 100%);color:#fff;padding:1.6rem 20px 1.4rem; line-height: 1.45;}
.cover-inner{max-width:1800px;margin:0 auto; min-height: 60px;}
header{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:16px}
.eyebrow{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#C0DD97;font-weight:600;margin-bottom:8px}
h1{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:1.55rem;font-weight:700;margin:0 0 .25rem;letter-spacing:-0.01em;line-height:1.2}
.range{text-align:right;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;color:rgba(255,255,255,.8);line-height:1.7}.range b{color:#fff;font-weight:600}
.fbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:18px 0 4px;min-height:30px}
.fbar .lab{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--mut);font-weight:600}
.fchip{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;font-weight:500;display:inline-flex;align-items:center;gap:8px;padding:5px 12px;border-radius:20px;background:var(--sel);border:1px solid var(--sel-line);color:#0B6E3A}
.fchip button{background:none;border:none;color:#0B6E3A;cursor:pointer;font-size:15px;line-height:1;opacity:.7;padding:0}.fchip button:hover{opacity:1}
.fbar .none{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;color:var(--mut)}
.fbar .clr{margin-left:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;color:var(--accent);cursor:pointer;font-weight:600;border:none;background:none}
.kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin:8px 0 0;border-radius:10px;overflow:hidden}
.kpi{background:var(--card);padding:14px 13px 12px}
.kpi .lab{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--mut);font-weight:500}
.kpi .val{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:22px;font-weight:600;letter-spacing:-.02em;margin-top:6px;font-variant-numeric:tabular-nums}
.kpi .sub{font-size:10px;color:var(--mut);margin-top:2px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif}
.kpi.acc .val{color:var(--accent)}.kpi.mon .val{color:var(--money)}.kpi.ret .val{color:var(--ret)}.kpi.sq .val{color:var(--sq)}
.kpicap{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);font-weight:600;margin:16px 2px 7px;display:flex;align-items:center;gap:8px}
.kpicap .ln{flex:1;height:1px;background:var(--line)}
.kpis2{display:grid;grid-template-columns:repeat(6,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin:0 0 4px;border-radius:10px;overflow:hidden}
.kpis2 .kpi .val{font-size:20px}
.note{font-size:12px;color:var(--mut);margin:14px 2px 26px;line-height:1.55}.note b{color:var(--ink2);font-weight:600}
.sec{margin-top:36px}
.sec-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:12px;flex-wrap:wrap}
.sec-title{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;font-weight:600;letter-spacing:-.01em}
.sec-num{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:var(--accent);font-weight:600;margin-right:8px}
.sec-sub{font-size:12px;color:var(--mut)}
.sub-title{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;font-weight:600;margin:22px 0 9px;display:flex;align-items:center;gap:9px}
.dot{width:9px;height:9px;border-radius:50%;display:inline-block}
.strip{display:flex;gap:4px;align-items:flex-end;padding:14px 2px 0;border-bottom:1px solid var(--line);margin-bottom:4px;overflow-x:auto}
.sbar{flex:1;min-width:24px;display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer}
.sbar .col{width:100%;max-width:30px;background:var(--bar-bg);border-radius:3px 3px 0 0;display:flex;align-items:flex-end;transition:.15s;height:70px}
.sbar .fill{width:100%;background:var(--accent);border-radius:3px 3px 0 0;transition:.2s}
.sbar .d{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10px;color:var(--mut)}
.sbar .p{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10px;color:var(--ink2);font-weight:600}
.sbar:hover .col{outline:2px solid var(--accent-soft)}.sbar.on .fill{background:var(--ink)}.sbar.on .p{color:var(--ink)}
table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
th{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:9.5px;letter-spacing:.03em;text-transform:uppercase;color:var(--mut);font-weight:600;text-align:right;padding:9px 9px;border-bottom:1.5px solid var(--ink);cursor:pointer;user-select:none;white-space:nowrap}
th.l{text-align:left}th:hover{color:var(--ink)}
th .ar{opacity:.35;font-size:9px;margin-left:2px}th.sort .ar{opacity:1;color:var(--accent)}
td{padding:8px 9px;text-align:right;border-bottom:1px solid var(--line2);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12.5px}
td.l{text-align:left;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px}
tbody tr:hover{background:#F3F7F3}
tr.pick{cursor:pointer}tr.on{background:var(--sel)!important}tr.on td{color:var(--ink);font-weight:500}
tr.on td:first-child{box-shadow:inset 3px 0 0 var(--sel-line)}
.rank{color:var(--mut);font-size:11px;width:26px}
.rc{position:relative}.retbar{display:inline-block;height:6px;border-radius:3px;vertical-align:middle;margin-right:6px}
.retv{color:var(--ret);font-weight:500}.sqv{color:var(--sq);font-weight:500}
.money-c{color:var(--money);font-weight:500}.neg{color:#c0392b}.pos{color:var(--ink2)}.avg{color:var(--ink2)}.zero{color:#C3CCD4}
.chdot{width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:7px;vertical-align:middle}
.src{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;color:var(--mut)}
.tblwrap{border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--card)}
.tblscroll{max-height:460px;overflow-y:auto}
thead th{position:sticky;top:0;background:var(--card);z-index:2}
tfoot td{border-top:1.5px solid var(--ink);border-bottom:none;font-weight:600;color:var(--ink);background:#FAFBF9;position:sticky;bottom:0}
footer{margin-top:44px;padding-top:16px;border-top:1px solid var(--line);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;color:var(--mut);display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}
.chanrow{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:4px 0 8px}
.chan{border:1px solid var(--line);border-radius:9px;padding:13px 15px;background:var(--card);border-top:3px solid var(--line)}
.chan.st{border-top-color:var(--stream)}.chan.af{border-top-color:var(--aff)}.chan.di{border-top-color:var(--direct)}
.chan .cl{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;font-weight:600}
.chan.st .cl{color:var(--stream)}.chan.af .cl{color:var(--aff)}.chan.di .cl{color:var(--direct)}
.chan .cv{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:20px;font-weight:600;margin-top:6px}
.chan .cg{display:flex;gap:11px;margin-top:8px;flex-wrap:wrap}
.chan .cg span{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;color:var(--mut)}.chan .cg b{color:var(--ink2);font-weight:600}
@media(max-width:1050px){.kpis{grid-template-columns:repeat(4,1fr)}.kpis2{grid-template-columns:repeat(3,1fr)}h1{font-size:24px}.chanrow{grid-template-columns:1fr}}
@media(max-width:560px){.kpis,.kpis2{grid-template-columns:repeat(2,1fr)}}

.cpscroll{overflow-x:auto}
#cpTbl{width:auto;min-width:auto}
#cpTbl td{padding:2.5px 4px;white-space:nowrap;font-size:10.5px;line-height:1.25}
#cpTbl th{padding:4px 4px;font-size:8.5px}
#cpTbl td.l,#cpTbl th.l{max-width:96px;overflow:hidden;text-overflow:ellipsis}
#cpTbl td.l{font-size:11px}
#cpTbl thead th{position:static}
#cpTbl tfoot td{position:static;padding:4px 4px}

.sec-head{cursor:pointer;user-select:none}
.sec-tog{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;font-weight:600;line-height:1;
  width:20px;height:20px;border:1px solid var(--line);border-radius:5px;background:var(--card);
  color:var(--mut);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;
  margin-right:9px;flex:none;transition:.12s;padding:0}
.sec-head:hover .sec-tog{border-color:var(--accent);color:var(--accent)}
.sec.closed .sec-tog{background:var(--accent);border-color:var(--accent);color:#fff}
.sec-body{overflow:hidden}
.sec.closed .sec-body{display:none}
.sec.closed{padding-bottom:10px;border-bottom:1px solid var(--line2)}
.sec.closed .sec-head{margin-bottom:0}
/* Every closed row is one line of the same height now, so give them all the
   same gap. Not `.sec.closed + .sec.closed`: some sections carry an inline
   <style> or <script> between them, which breaks the adjacent-sibling match and
   left two of the gaps at the open-state 36px. */
.sec.closed{margin-top:14px}
.sec-body>.sec-sub{margin:-4px 0 12px}
#secAll{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;color:var(--accent);
  background:none;border:none;cursor:pointer;margin-left:auto;padding:0}
.secbar{display:flex;margin:26px 2px -14px}

#gfBar{margin:16px 0 0}
/* the first section sits under the bar and the expand-all row, so it needs no
   top margin of its own; without this the 01/02 gap is twice every other gap */
#kpiBlock{margin-top:0}
#kpiBlock .kpis{margin-top:0}
#kpiBlock:not(.closed){padding-bottom:10px;border-bottom:1px solid var(--line2)}
/* .fbar carries its own 18px top margin and a 30px min-height for the filter
   chips; inside a section header that made the closed row 63px against every
   other row's 37px */
#kpiBlock .sec-head .fbar{margin:0;min-height:0}
/* the expand-all row used a -14px bottom margin to tuck under the old first
   section; with section 01 no longer carrying a top margin that overlapped the
   FILTERS line */
.secbar{margin:18px 2px 6px}
/* The grey hints in the section headers ("click a day to filter the whole
   report", "click a depositor above", ...) explain controls that are visible
   once you open the section anyway, and they made the collapsed list noisy.
   Hidden rather than deleted because the render code still writes to them. */
.sec-head .sec-sub{display:none}
/* the active-filter line is status, not a hint, so it stays */
#kpiBlock .sec-head .fbar{display:flex}
</style></head>
<body>
<div class="cover"><div class="cover-inner">
<header><div><div class="eyebrow">First-Time Deposits · August 2026</div><h1>August FTD Performance</h1></div>
<div class="range"><div><b id="hRange"></b></div><div id="hDays"></div></div></header>
</div></div>
<div class="wrap">
<div id="gfBar"><div class="gflab">Filter &middot; applies to every section</div><div id="dcSwitch"><button class="dcbtn on" data-ch="">All</button><button class="dcbtn" data-ch="s">Streamer</button><button class="dcbtn" data-ch="a">Affiliate</button><button class="dcbtn" data-ch="seo">SEO</button><button class="dcbtn" data-ch="d">Direct</button><button class="dcbtn" data-ch="com">Community</button></div>
  <div id="dcSrcSwitch"></div>
  <div id="dcRailSwitch"><button class="dcbtn on" data-y="">All rails</button><button class="dcbtn" data-y="c">Crypto</button><button class="dcbtn" data-y="f">Fiat</button></div>
  <div id="dcFavSwitch"></div></div>
<style>
#gfBar{margin:14px 0 4px;padding:11px 14px;background:var(--card);border:1px solid var(--line);border-radius:10px}
#gfBar .gflab{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--mut);font-weight:600;margin-bottom:8px}
#gfBar #dcSwitch{margin-top:0}
#dcRailSwitch,#dcFavSwitch{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
#dcRailSwitch .dcbtn,#dcFavSwitch .dcbtn{padding:3px 12px;border:1px solid #C3CCD4;background:#fff;border-radius:14px;cursor:pointer;font-family:inherit;font-size:12px;font-weight:600;color:#5B7285}
#dcRailSwitch .dcbtn.on{background:#0B6E3A;color:#fff;border-color:#0B6E3A}
#dcFavSwitch .dcbtn.on{background:#4E9D5C;color:#fff;border-color:#4E9D5C}
</style>

<script>
/* One filter for the whole report. __dcCh and __dcSrc are the only state; every
   section reads them through gfRow, so nothing can drift out of sync. Channel
   and source are mutually exclusive because a source already implies a channel
   (SEO sits inside Affiliate) and holding both would usually mean "nothing". */
window.__gfHooks = [];
/* Sections that have to redraw when a day is picked in the daily table, kept
   apart from __gfHooks because the two fire on different events: the global
   filters redraw everything, a day redraws the month-comparison tables only.
   __selDayOf hands them the day number on its own — those tables compare the
   same day across three different months, so the year and month in selDay are
   exactly the part they must not look at. */
window.__dayHooks = [];
window.__selDayOf = function () { return null; };
window.GFLAB = {s:'Streamer', a:'Affiliate', seo:'SEO', d:'Direct', com:'Community'};
window.gfBucket = function (ch, src) {
  return src === 'Community' ? 'com' : (src === 'SEO' ? 'seo' : ch);
};
window.gfRow = function (ch, src, pay, fav) {
  var c = window.__dcCh || null, k = window.__dcSrc || null,
      y = window.__dcRail || null, f = window.__dcFav || null;
  return (!c || window.gfBucket(ch, src) === c) && (!k || src === k)
      && (!y || pay === y) && (!f || (fav || 'Unknown') === f);
};
window.gfUser = function (u) {
  var m = window.PMETA[u];
  return window.gfRow(m ? m[0] : null, m ? m[1] : null, m ? m[2] : null, m ? m[3] : null);
};
/* A registration is not a deposit: it has no payment rail and no favourite
   game. Anything counting registrations stands down while either is selected,
   rather than reporting a number that quietly ignores the filter. */
window.gfNoReg = function () { return !!(window.__dcRail || window.__dcFav); };
