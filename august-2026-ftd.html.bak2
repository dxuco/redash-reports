const PAFF=DATA.paff;
const U30=DATA.u30,REGS30=DATA.regs30,DAYS30=DATA.days30;
const MN30=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const dLab30=s=>s.slice(8)+' '+MN30[+s.slice(5,7)-1];
function filt30(o){o=o||{};var ch=o.ch||null;return U30.filter(function(r){return (!selCtry||r.c===selCtry)&&(!ch||r.ch===ch)&&(!selAff||r.af===selAff);});}
function regMap30(f,k){var m={};REGS30.forEach(function(x){if((!selAff||x.af===selAff)&&f(x)){var kk=k(x);m[kk]=(m[kk]||0)+x.r;}});return m;}
let selAff=null;
let selPlayer=null;let bSort={k:null,dir:null};
const $=s=>document.querySelector(s);
const fmtN=n=>Math.round(n).toLocaleString('en-US');
const fmtM=n=>'$'+n.toLocaleString('en-US',{minimumFractionDigits:0,maximumFractionDigits:0});
const fmtS=n=>{const s=n<0?'-':'';return s+'$'+Math.abs(Math.round(n)).toLocaleString('en-US');};
const pctW=n=>{if(n==null||!isFinite(n))return'—';const r=Math.round(n);if(r===0&&n!==0)return n>0?'<1%':'>-1%';return (r||0)+'%';};const ppW=d=>{if(d==null||!isFinite(d))return'—';const r=Math.round(d)||0;if(r===0&&d!==0)return(d>0?'<1pp':'>-1pp');return (r>0?'+':'')+r+'pp';};const fmtP=n=>pctW(n);const cmpP=(c,p)=>{if(!p)return '\u2014';const v=Math.round((c-p)/p*100);return '<span class="'+(v>=0?'pos':'neg')+'">'+(v>0?'+':'')+v+'%</span>';};
const dLabel=s=>s.slice(8)+' Aug';
let selDay=null,selCtry=null;
window.__selDayOf=function(){return selDay?selDay.slice(8,10):null;};
const S={daily:{k:'fd',dir:1},ctry:{k:'f',dir:-1},strm:{k:'f',dir:-1},aff:{k:'f',dir:-1},affMt:{k:'f',dir:-1},affComm:{k:'f',dir:-1},affTip:{k:'f',dir:-1},dir:{k:'f',dir:-1}};
let tSort={k:'ftd',dir:-1};
$('#hRange').textContent=dLabel(P.start)+' – '+dLabel(P.end)+' 2026';$('#hDays').textContent=DAYS.length+' days';
(function(){const MN=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];const dt=new Date(DATA.last);dt.setDate(dt.getDate()-7);const _rc=$('#retCut');if(_rc)_rc.textContent=String(dt.getDate()).padStart(2,'0')+' '+MN[dt.getMonth()];})();

function filt({day=true,ctry=true,ch=null,aff=true}={}){return U.filter(r=>(!day||!selDay||r.fd===selDay)&&(!ctry||!selCtry||r.c===selCtry)&&(!ch||r.ch===ch)&&(!aff||!selAff||r.af===selAff)&&gfRow(r.ch,r.src,r.pay,r.fav));}
const FK=['f','sq','blk','m','bet','dep','sqdep','ngr','adj','bonus','ret','obs','cr','fi'];
function group(rows,keys){const m={};rows.forEach(r=>{const key=keys.map(f=>r[f]).join('|');let o=m[key];
  if(!o){o=m[key]={};keys.forEach(f=>o[f]=r[f]);FK.forEach(k=>o[k]=0);}FK.forEach(k=>o[k]+=r[k]);});
  return Object.values(m).map(o=>({...o,avg:o.f?o.m/o.f:0,retp:o.obs?o.ret/o.obs*100:null}));}
function totals(rows){const s=k=>rows.reduce((a,x)=>a+x[k],0);const f=s('f'),ob=s('obs'),rt=s('ret');
  return {f,sq:s('sq'),blk:s('blk'),m:s('m'),bet:s('bet'),dep:s('dep'),sqdep:s('sqdep'),ngr:s('ngr'),adj:s('adj'),bonus:s('bonus'),ret:rt,obs:ob,cr:s('cr'),fi:s('fi'),avg:f?s('m')/f:0,retp:ob?rt/ob*100:null};}
function regMap(filterFn,keyFn){const m={};REGS.forEach(x=>{if((!selAff||x.af===selAff)&&!gfNoReg()&&!gfNoReg()&&gfRow(x.ch,x.src)&&filterFn(x)){const k=keyFn(x);m[k]=(m[k]||0)+x.r;}});return m;}
function regTotal(filterFn){let s=0;REGS.forEach(x=>{if((!selAff||x.af===selAff)&&!gfNoReg()&&!gfNoReg()&&gfRow(x.ch,x.src)&&filterFn(x))s+=x.r;});return s;}
function sortRows(rows,st,txt){rows.sort((a,b)=>{const k=st.k;let x,y;if(k==='reg2dep'){x=a.reg?a.f/a.reg:-1;y=b.reg?b.f/b.reg:-1;}else{x=a[k];y=b[k];}if(x==null)x=-1;if(y==null)y=-1;return txt.includes(k)?(x>y?1:x<y?-1:0)*st.dir:(x-y)*st.dir;});return rows;}
function markSort(sel,st){document.querySelectorAll(sel+' thead th').forEach(th=>th.classList.toggle('sort',th.dataset.k===st.k));}
function hookSort(sel,st,txt,render){document.querySelectorAll(sel+' thead th').forEach(th=>{if(!th.dataset.k)return;th.onclick=()=>{const k=th.dataset.k;st.dir=st.k===k?-st.dir:(txt.includes(k)?1:-1);st.k=k;render();};});}
function r2dCell(c){const reg=c.reg||0;if(!reg)return '<td class="zero">—</td>';const v=c.f/reg*100;const bw=Math.max(2,(Math.min(v,60)/60)*40);
  return `<td class="rc"><span class="retbar" style="width:${bw}px;background:var(--accent)"></span><span style="color:var(--accent);font-weight:500">${pctW(v)}</span></td>`;}
function retCell(c){if(c.retp==null||c.obs===0)return '<td class="zero" title="not enough history">—</td>';const bw=c.retp?Math.max(2,(c.retp/70)*36):0;
  return c.retp?`<td class="rc"><span class="retbar" style="width:${bw}px;background:var(--ret)"></span><span class="retv">${fmtP(c.retp)}</span></td>`:'<td class="zero">0.0%</td>';}
function sqCell(c){return c.sq?`<td class="sqv">${fmtN(c.sq)}</td>`:'<td class="zero">0</td>';}
function ngrCell(n){if(!n)return '<td class="zero">$0</td>';return `<td class="${n<0?'neg':'pos'}">${fmtS(n)}</td>`;}
function metricCells(c){return `<td>${gfNoReg()?'<span class="zero">\u2014</span>':fmtN(c.reg||0)}</td><td>${fmtN(c.f)}</td>${sqCell(c)}${r2dCell(c)}
  <td class="money-c">${c.m?fmtM(c.m):'<span class=zero>—</span>'}</td><td class="${c.avg?'avg':'zero'}">${c.avg?fmtM(c.avg):'—'}</td>
  <td class="money-c">${c.dep?fmtM(c.dep):'<span class=zero>—</span>'}</td>${ngrCell(c.ngr)}`;}
function ggrBonusCells(c){return `${ngrCell(c.adj)}<td class="money-c">${c.bonus?fmtM(c.bonus):'<span class=zero>—</span>'}</td>`;}
function payCells(c){const cr=c.cr||0,fi=c.fi||0;
  return `<td class="${cr?'':'zero'}" style="color:${cr?'var(--accent)':''}">${fmtN(cr)}</td><td class="${fi?'':'zero'}" style="color:${fi?'var(--money)':''}">${fmtN(fi)}</td>`;}
function foot(rows,lead,extra){const t=totals(rows);const tr=rows.reduce((s,x)=>s+(x.reg||0),0);
  return `<tr>${lead}<td>${fmtN(tr)}</td><td>${fmtN(t.f)}</td><td>${fmtN(t.sq)}</td><td>${tr?fmtP(t.f/tr*100):'—'}</td>
  <td>${fmtM(t.m)}</td><td>${t.f?fmtM(t.avg):'—'}</td><td>${fmtM(t.dep)}</td>${ngrCell(t.ngr)}${extra?extra(t):''}</tr>`;}

function renderBar(){let h='<span class="lab">Filters</span>';
  const _gl=[(window.__dcSrc||GFLAB[window.__dcCh||'']||''),({c:'Crypto',f:'Fiat'})[window.__dcRail||'']||'',window.__dcFav||''].filter(Boolean).join(' \u00b7 ');
  if(_gl)h+=`<span class="fchip">${_gl}<button data-x="gf">×</button></span>`;
  if(!selDay&&!selCtry&&!selAff&&!_gl)h+='<span class="none">none — month-to-date (days 1–25)</span>';
  if(selDay)h+=`<span class="fchip">FTD Day · ${dLabel(selDay)}<button data-x="day">×</button></span>`;
  if(selCtry)h+=`<span class="fchip">Country · ${selCtry}<button data-x="ctry">×</button></span>`;
  if(selAff)h+=`<span class="fchip">Partner · ${selAff}<button data-x="aff">×</button></span>`;
  if(selDay||selCtry||selAff)h+='<button class="clr" id="clrAll">clear all</button>';
  $('#fbar').innerHTML=h;$('#fbar').querySelectorAll('button[data-x]').forEach(b=>b.onclick=()=>{
    if(b.dataset.x==='gf'){document.querySelector('#dcFavSwitch .dcbtn[data-p=""]').click();document.querySelector('#dcRailSwitch .dcbtn[data-y=""]').click();document.querySelector('#dcSwitch .dcbtn[data-ch=""]').click();return;}
    if(b.dataset.x==='day')selDay=null;else if(b.dataset.x==='ctry')selCtry=null;else selAff=null;renderAll();});
  const ca=$('#clrAll');if(ca)ca.onclick=()=>{selDay=null;selCtry=null;selAff=null;renderAll();};}
function kpiPlayers(){return DATA.top50.filter(r=>(!selDay||r.fd===selDay)&&(!selCtry||r.c===selCtry)&&(!selAff||PAFF[r.u]===selAff)&&gfUser(r.u));}
function medianOf(v){if(!v.length)return 0;const a=v.slice().sort((x,y)=>x-y),m=a.length>>1;return a.length%2?a[m]:(a[m-1]+a[m])/2;}
function renderKpis(){if(window.renderScore)window.renderScore();return;const P=gfP();const t=totals(filt());const pl=kpiPlayers();const med=medianOf(pl.map(r=>r.ftd));const ones=pl.filter(r=>(r.dc||0)<=1);const one=ones.length;const oneB=ones.reduce((a,r)=>a+(r.bonus||0),0);const scope=[selAff,selCtry,selDay?dLabel(selDay):null].filter(Boolean).join(' · ')||'days 1–25';
  const tr=regTotal(x=>(!selDay||x.d===selDay)&&(!selCtry||x.c===selCtry));
  $('#kpis').innerHTML=[['Registrations',fmtN(tr),scope,''],['FTD Count',fmtN(t.f),'first deposits','acc'],['FTD vs Jul 2026',cmpP(P.ftd,P.ftd_pm),'Jul MTD: '+fmtN(P.ftd_pm),'acc'],['FTD vs Aug 2025',cmpP(P.ftd,P.ftd_py),"Aug '25 MTD: "+fmtN(P.ftd_py),'acc'],
   ['SQ FTD',fmtN(t.sq),'super qualified','sq'],['Reg2Dep',tr?fmtP(t.f/tr*100):'—','FTD ÷ reg','acc'],
   ['7D Retention',t.retp==null?'—':fmtP(t.retp),'re-deposit ≤7d','ret'],['Blocked %',t.f?fmtP(t.blk/t.f*100):'—','of FTD count','ret'],['FTD Amount',fmtM(t.m),'first deposits','mon'],
   ['Avg FTD',t.f?fmtM(t.avg):'—','per user','mon'],['Avg FTD Aug 2025',fmtM(P.avgftd_py),'current '+cmpP(t.avg,P.avgftd_py),'mon'],['Avg FTD Jul 2025',fmtM(P.avgftd_pj25),'current '+cmpP(t.avg,P.avgftd_pj25),'mon'],['Median FTD',med?fmtM(med):'—','half deposit less','mon'],['Median Jul 2026',fmtM(P.med_pm),'current '+cmpP(med,P.med_pm),'mon'],['Median Aug 2025',fmtM(P.med_py),'current '+cmpP(med,P.med_py),'mon'],['One-Time FTDs',fmtN(one),(pl.length?Math.round(one/pl.length*100):0)+'% of '+fmtN(pl.length)+' · one deposit so far','ret'],['Bonus · One-Time',fmtS(oneB),(t.bonus?Math.round(oneB/t.bonus*100):0)+'% of MTD bonus · '+fmtN(one)+' players','ret']]
   .map(k=>`<div class="kpi ${k[3]}"><div class="lab">${k[0]}</div><div class="val">${k[1]}</div><div class="sub">${k[2]}</div></div>`).join('');}
function renderKpis2(){return;const t=totals(filt());
  const he=Math.abs(t.bet)>0.01?t.adj/t.bet*100:null,ratio=Math.abs(t.adj)>0.01?t.bonus/t.adj*100:null;
  const cell=(l,v,s,c)=>`<div class="kpi ${c}"><div class="lab">${l}</div><div class="val">${v}</div><div class="sub">${s}</div></div>`;
  $('#kpis2').innerHTML=cell('Total Deposits',fmtS(t.dep),'MTD','mon')+cell('Total Bet',fmtS(t.bet),'turnover','mon')+
    cell('Adj GGR',fmtS(t.adj),'adjusted GGR',t.adj<0?'':'acc')+cell('House Edge',he==null?'—':pctW(he),'Adj GGR ÷ bet','ret')+
    cell('Bonus Cost',fmtS(t.bonus),'MTD bonus','mon')+cell('Total NGR',fmtS(t.ngr),'net gaming rev',t.ngr<0?'':'acc')+
    cell('Bonus Cost / GGR',ratio==null?'—':fmtP(ratio),'bonus efficiency','ret');}

function dailyData(){const rows=group(filt({day:false}),['fd']);const map={};rows.forEach(r=>map[r.fd]=r);
  const rm=regMap(x=>(!selCtry||x.c===selCtry),x=>x.d);
  return DAYS.map(d=>({...(map[d]||{fd:d,f:0,sq:0,blk:0,m:0,bet:0,dep:0,sqdep:0,ngr:0,adj:0,bonus:0,ret:0,obs:0,cr:0,fi:0,avg:0,retp:null}),reg:rm[d]||0}));}
function renderStripDaily(){const dd=dailyData();const maxF=Math.max(...dd.map(x=>x.f),1);
  $('#strip').innerHTML=dd.map(d=>{const h=Math.max(4,(d.f/maxF)*100);
    return `<div class="sbar ${selDay===d.fd?'on':''}" data-d="${d.fd}"><div class="p">${d.f}</div><div class="col"><div class="fill" style="height:${h}%"></div></div><div class="d">${d.fd.slice(8)}</div></div>`;}).join('');
  document.querySelectorAll('.sbar').forEach(b=>b.onclick=()=>{selDay=selDay===b.dataset.d?null:b.dataset.d;renderAll();});
  const rows=sortRows(dailyData(),S.daily,['fd']);
  $('#dailyBody').innerHTML=rows.map(d=>`<tr class="pick ${selDay===d.fd?'on':''}" data-d="${d.fd}"><td class="l">${dLabel(d.fd)}</td>${metricCells(d)}${ggrBonusCells(d)}${payCells(d)}</tr>`).join('');
  document.querySelectorAll('#dailyBody tr').forEach(r=>r.onclick=()=>{selDay=selDay===r.dataset.d?null:r.dataset.d;renderAll();});
  $('#dailyFoot').innerHTML=foot(dailyData(),`<td class="l">Total · ${selCtry?selCtry:DAYS.length+' days'}</td>`,function(t){return ggrBonusCells(t)+payCells(t);});
  $('#s1sub').textContent=selCtry?`FTDs for ${selCtry} · click a day to add filter`:'Click a day to filter the whole report';markSort('#dailyTbl',S.daily);}
const CHC={s:'var(--stream)',a:'var(--aff)',d:'var(--direct)'};
function moneyCell(n){if(n==null||n===0)return '<td class="zero">$0</td>';return `<td class="${n<0?'neg':'pos'}">${fmtS(n)}</td>`;}
/* Month names, so this column carries no literal month for the next build to
   retarget — every other dated label on the page needs rewriting when the
   report rolls forward, and this one does not. */
const MONS=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
/* Last day the player bet or deposited. Greyed once it is more than a week
   behind the reporting cut-off, which is the same seven-day horizon the 7D
   retention figure uses — a player quiet for longer has stopped, not paused. */
function lastCell(d){
  if(!d) return '<td class="zero l">\u2014</td>';
  const gap=Math.round((Date.parse(P.end)-Date.parse(d))/86400000);
  const stale=gap>=3;
  return '<td class="l" style="font-family:-apple-system,BlinkMacSystemFont,\'Segoe UI\',Roboto,Helvetica,Arial,sans-serif;font-size:12px;'+
    (stale?'color:#C0392B;font-weight:600':'color:var(--ink2)')+'" title="'+gap+' day'+(gap===1?'':'s')+' before the cut-off">'+
    d.slice(8)+' '+MONS[+d.slice(5,7)-1]+'</td>';}
function renderTop50(){let rows=DATA.top50.filter(r=>(!selDay||r.fd===selDay)&&(!selCtry||r.c===selCtry)&&(!selAff||PAFF[r.u]===selAff)&&gfUser(r.u));
  const total=rows.length;const k=tSort.k;const txt=(k==='u'||k==='c'||k==='fd'||k==='last'||k==='aff');
  const kv=r=>k==='aff'?(PAFF[r.u]||''):r[k];
  rows.sort((a,b)=>{let x=kv(a),y=kv(b);if(x==null)x=-1e15;if(y==null)y=-1e15;return txt?(x>y?1:x<y?-1:0)*tSort.dir:(x-y)*tSort.dir;});
  rows=rows.slice(0,50);
  const ts=$('#topSub');if(ts)ts.textContent=(selDay||selCtry)?('Top depositors'+(selCtry?' · '+selCtry:'')+(selDay?' · '+dLabel(selDay):'')+' ('+rows.length+' of '+total+')'):'Highest August first-time deposits · follows the day/country filters';
  $('#topBody').innerHTML=rows.map((r,i)=>`<tr class="pick ${selPlayer===r.u?'on':''}" data-u="${r.u.replace(/"/g,'&quot;')}"><td class="l rank">${i+1}</td>
    <td class="l"><span class="chdot" style="background:${CHC[r.ch]}" title="${r.ch==='s'?'Streamer':r.ch==='a'?'Affiliate':'Direct'}"></span>${r.u}</td>
    <td class="l">${r.c}</td><td class="l" style="max-width:132px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${(PAFF[r.u]||'').replace(/"/g,'&quot;')}">${PAFF[r.u]||'<span class="zero">\u2014</span>'}</td><td class="l">${r.blk?'<b style="color:#C0392B">Blocked</b>':'<span style="color:var(--mut)">Active</span>'}</td><td class="l" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;color:var(--ink2)">${r.fd?r.fd.slice(8)+' Aug':'—'}</td>${lastCell(r.last)}
    <td class="money-c">${fmtS(r.ftd)}</td>${moneyCell(r.dep)}${moneyCell(r.adj)}${moneyCell(r.ngr)}${moneyCell(r.bonus)}
    <td class="${r.ratio==null?'zero':(r.ratio<0?'neg':'pos')}">${r.ratio==null?'—':pctW(r.ratio)}</td></tr>`).join('');
  document.querySelectorAll('#topBody tr[data-u]').forEach(tr=>tr.onclick=()=>{selPlayer=selPlayer===tr.dataset.u?null:tr.dataset.u;renderTop50();renderGames();renderFunnel();renderBonus();});
  const sum=k2=>rows.reduce((s,x)=>s+(x[k2]||0),0);const tadj=sum('adj'),tbon=sum('bonus'),tob=sum('obs'),trt=sum('ret'),tretp=tob?trt/tob*100:null;
  $('#topFoot').innerHTML=`<tr><td></td><td class="l">Top ${rows.length}</td><td></td><td class="l">${sum('blk')} blocked</td><td></td><td></td><td>${fmtS(sum('ftd'))}</td>${moneyCell(sum('dep'))}${moneyCell(tadj)}${moneyCell(sum('ngr'))}${moneyCell(tbon)}<td class="${Math.abs(tadj)>0.01?(tbon/tadj<0?'neg':'pos'):'zero'}">${Math.abs(tadj)>0.01?pctW(tbon/tadj*100):'—'}</td></tr>`;
  document.querySelectorAll('#topTbl thead th').forEach(th=>th.classList.toggle('sort',th.dataset.k===tSort.k));}
document.querySelectorAll('#topTbl thead th').forEach(th=>{if(!th.dataset.k)return;th.onclick=()=>{const k=th.dataset.k;tSort.dir=tSort.k===k?-tSort.dir:((k==='u'||k==='c'||k==='fd')?1:-1);tSort.k=k;renderTop50();};});



function ggrCell(n){if(!n)return '<td class="zero">$0</td>';return `<td class="${n<0?'neg':'pos'}">${fmtS(n)}</td>`;}
/* Built here rather than calling gk(): that lives in another <script> block and `const` is script-scoped, so it is invisible from this one. The __dc* values are window properties, so they cross the boundary. */function gamesKey(){var b=window.__dcSrc?('@'+window.__dcSrc):(window.__dcCh||'');var r=window.__dcRail||'',f=window.__dcFav||'';return (r||f)?b+'|'+r+'|'+f:b;}function cmpCats(which){const s=(DATA.gamesCmp||{})[which]||{};return s[gamesKey()]||{};}function cmpTots(which){const s=(DATA.gamesCmpTot||{})[which]||{};return s[gamesKey()]||null;}function adjFor(which){const s=(DATA.aggrTot||{})[which];return (s&&typeof s==='object')?(s[gamesKey()]||0):(s||0);}const PMLAB='Jul 2026',PYLAB='Aug 2025';function narrowedGames(){return !!(selCtry||selAff);}const CURLAB='Aug 2026';function gameGroup(o,cmp){const bl=cmp?' style="border-left:1px solid #D8DEE0"':'';if(cmp&&narrowedGames())return '<td'+bl+' class="zero">—</td><td class="zero">—</td><td class="zero">—</td><td class="zero">—</td>';if(!o)return '<td'+bl+' class="zero">—</td><td class="zero">—</td><td class="zero">—</td><td class="zero">—</td>';return '<td'+bl+'>'+fmtN(o.players||0)+'</td><td class="money-c">'+fmtM(o.bet||0)+'</td>'+ggrCell(o.ggr||0)+ggrCell(o.ngr||0);}function groupTot(which){return cmpTots(which);}function cmpCell(o){if(narrowedGames())return '<td class="zero">—</td>';return o?ggrCell(o.ggr):'<td class="zero">—</td>';}function cmpTot(which){const T=cmpTots(which);return (narrowedGames()||!T)?'—':fmtS(T.ggr);}function playerAdj(u){const r=(DATA.top50||[]).find(x=>x.u===u);return r?r.adj:0;}
function renderFunnel(){
  var wrap=document.getElementById('funnelWrap'), sub=document.getElementById('funnelSub');
  if(!wrap) return;
  var F=(DATA.funnel||{})[gamesKey()]||null;
  if(!F||!F.rows||!Object.keys(F.rows).length){
    wrap.innerHTML='<div style="padding:18px 14px;color:var(--mut);font-size:13px">No first-day play for this selection.</div>';
    if(sub) sub.innerHTML='';
    return;
  }
  var rows=Object.keys(F.rows).sort(function(a,b){return F.rows[b].players-F.rows[a].players;});
  /* Columns are every category anyone moved into, plus every entry category,
     so the diagonal always has a column to sit on. */
  var dest={};
  rows.forEach(function(c){ dest[c]=1; Object.keys(F.rows[c].to).forEach(function(x){dest[x]=1;}); });
  var cols=Object.keys(dest).sort();
  var tot={players:0,none:0};
  rows.forEach(function(c){ tot.players+=F.rows[c].players; tot.none+=F.rows[c].none; });
  /* Everyone in a row either came back or did not, so this is the one split of
     the row that is exact. It is also the denominator for the cells: the
     categories describe where returners went, and the people who never bet
     again are not part of that question. */
  var totBack=tot.players-tot.none;

  var h='<table><thead><tr><th class="l">Opened with</th>'+
    cols.map(function(c){return '<th style="text-transform:capitalize">'+c+'</th>';}).join('')+
    '<th style="border-left:1px solid #D8DEE0">Never played again</th><th>Came back</th><th>Players</th></tr></thead><tbody>';
  rows.forEach(function(c){
    var r=F.rows[c];
    var back=r.players-r.none;
    h+='<tr><td class="l" style="text-transform:capitalize">'+c+'</td>'+
      cols.map(function(x){
        var v=r.to[x]||0;
        if(!v||!back) return '<td class="zero">&mdash;</td>';
        /* The diagonal — came back to what they started with. */
        var same=(x===c);
        /* The count stays in the title: a percentage on its own hides how thin
           some of these baskets are, and 100% of two players is not news. */
        return '<td'+(same?' style="font-weight:700;color:var(--ink)"':'')+' title="'+
          fmtN(v)+' of the '+fmtN(back)+' who opened with '+c+' and came back played '+x+' on a later day">'+
          pctW(v/back*100)+'</td>';
      }).join('')+
      '<td style="border-left:1px solid #D8DEE0;color:var(--warn)">'+fmtN(r.none)+'</td>'+
      '<td>'+fmtN(back)+'</td>'+
      '<td style="font-weight:700">'+fmtN(r.players)+'</td></tr>';
  });
  if(F.neverBet){
    h+='<tr style="color:var(--mut)"><td class="l">Never placed a bet</td>'+
      cols.map(function(){return '<td class="zero">&mdash;</td>';}).join('')+
      '<td style="border-left:1px solid #D8DEE0">'+fmtN(F.neverBet)+'</td>'+
      '<td class="zero">&mdash;</td>'+
      '<td style="font-weight:700">'+fmtN(F.neverBet)+'</td></tr>';
  }
  h+='</tbody><tfoot><tr><td class="l">All first depositors</td>'+
    cols.map(function(x){
      var s=0; rows.forEach(function(c){ s+=F.rows[c].to[x]||0; });
      return '<td title="'+fmtN(s)+' of the '+fmtN(totBack)+' who came back">'+
        ((s&&totBack)?pctW(s/totBack*100):'<span class="zero">&mdash;</span>')+'</td>';
    }).join('')+
    '<td style="border-left:1px solid #D8DEE0">'+fmtN(tot.none+F.neverBet)+'</td>'+
    '<td>'+fmtN(totBack)+'</td>'+
    '<td>'+fmtN(tot.players+F.neverBet)+'</td></tr></tfoot></table>';
  wrap.innerHTML=h;

  if(sub) sub.innerHTML='Each first depositor is placed by the category they bet most on their first day, then followed. '+
    'A cell is the share of that row\u2019s <b>came back</b> players who played that category on a <b>later</b> day \u2014 hover for the count. '+
    'Someone who went on to play two categories is in both, so a row can add to more than 100%. '+
    'The <b>bold diagonal</b> is players who came back to the category they started in. '+
    '<b>'+fmtN(tot.none+F.neverBet)+'</b> of <b>'+fmtN(tot.players+F.neverBet)+'</b> never played again after day one.';
}
function renderGames(){const wrap=$('#gamesWrap'),sub=$('#gamesSub');
  if(selPlayer){
    let rows=GAMES.filter(r=>r.u===selPlayer).slice().sort((a,b)=>b.bet-a.bet);
    const tb=rows.reduce((s,x)=>s+x.bet,0),tg=rows.reduce((s,x)=>s+x.ggr,0),tn=rows.reduce((s,x)=>s+x.ngr,0);
    const padj=ADJ.filter(r=>r.u===selPlayer).reduce((s,x)=>s+x.adj,0);
    sub.innerHTML=`Game categories played by <b style="color:var(--ink)">${selPlayer}</b> · <button id="gClr" style="border:none;background:none;color:var(--accent);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;cursor:pointer">clear</button>`;
    if(!rows.length){wrap.innerHTML='<div style="padding:18px 14px;color:var(--mut);font-size:13px">No game play recorded for this player.</div>';}
    else{wrap.innerHTML=`<table><thead><tr><th class="l">Game Category</th><th>Games</th><th>Bet</th><th>GGR</th><th>NGR</th></tr></thead>
      <tbody>${rows.map(r=>`<tr><td class="l" style="text-transform:capitalize">${r.prod}</td><td>${r.g}</td><td class="money-c">${fmtM(r.bet)}</td>${ggrCell(r.ggr)}${ggrCell(r.ngr)}</tr>`).join('')}</tbody>
      <tfoot>
      <tr><td class="l">Game play · ${rows.length} categories</td><td></td><td>${fmtM(tb)}</td><td>${fmtS(tg)}</td><td>${fmtS(tn)}</td></tr>
      <tr><td class="l" title="Whole-account adjusted GGR for this player; it has no game category attached.">Adjusted GGR · whole account</td><td></td><td></td>${ggrCell(playerAdj(selPlayer))}<td></td></tr></tfoot></table>`;}
    const c=$('#gClr');if(c)c.onclick=()=>{selPlayer=null;renderTop50();renderGames();renderFunnel();renderBonus();};
  }else{
    let src=GAMES.filter(r=>(!selCtry||r.c===selCtry)&&(!selAff||PAFF[r.u]===selAff));
    const m={};src.forEach(r=>{let o=m[r.prod];if(!o)o=m[r.prod]={prod:r.prod,bet:0,ggr:0,ngr:0,pl:new Set()};o.bet+=r.bet;o.ggr+=r.ggr;o.ngr+=r.ngr;o.pl.add(r.u);});
    let rows=Object.values(m).map(o=>({prod:o.prod,bet:o.bet,ggr:o.ggr,ngr:o.ngr,players:o.pl.size})).sort((a,b)=>b.bet-a.bet);
    sub.innerHTML=`Play by game category${selCtry?' ('+selCtry+')':''} · <b>click a depositor above</b> to see their breakdown`;
    if(!rows.length){wrap.innerHTML='<div style="padding:18px 14px;color:var(--mut);font-size:13px">No game play for this selection.</div>';return;}
    const tb=rows.reduce((s,x)=>s+x.bet,0),tg=rows.reduce((s,x)=>s+x.ggr,0),tn=rows.reduce((s,x)=>s+x.ngr,0);
    const oadj=ADJ.filter(r=>(!selCtry||r.c===selCtry)).reduce((s,x)=>s+x.adj,0);
    wrap.innerHTML=`<table><thead><tr><th class="l" rowspan="2">Game Category</th><th colspan="4" style="text-align:center"><span class="grplab">${CURLAB}</span></th><th colspan="4" style="text-align:center;border-left:1px solid #D8DEE0"><span class="grplab">${PMLAB}</span></th><th colspan="4" style="text-align:center;border-left:1px solid #D8DEE0"><span class="grplab">${PYLAB}</span></th></tr><tr><th style="">Players</th><th>Bet</th><th>GGR</th><th>NGR</th><th style="border-left:1px solid #D8DEE0">Players</th><th>Bet</th><th>GGR</th><th>NGR</th><th style="border-left:1px solid #D8DEE0">Players</th><th>Bet</th><th>GGR</th><th>NGR</th></tr></thead>
      <tbody>${rows.map(r=>`<tr><td class="l" style="text-transform:capitalize">${r.prod}</td>` +
        gameGroup(r) + gameGroup(cmpCats('pm')[r.prod],true) + gameGroup(cmpCats('py')[r.prod],true) + `</tr>`).join('')}</tbody>
      <tfoot>
      <tr><td class="l">Game play · ${rows.length} categories</td>` +
        gameGroup({players:new Set(src.map(r=>r.u)).size,bet:tb,ggr:tg,ngr:tn}) +
        gameGroup(cmpTots('pm'),true) + gameGroup(cmpTots('py'),true) + `</tr>
      <tr style="font-weight:400;color:var(--mut)"><td class="l" style="font-weight:400" title="Adjusted GGR arrives on rows with no game category attached, so it cannot be split across the rows above.">Adjusted GGR · whole account, not split by category</td><td></td><td></td>${ggrCell(adjFor('cur'))}<td></td>${narrowedGames()?'<td></td><td></td><td class="zero">—</td><td></td><td></td><td></td><td class="zero">—</td><td></td>':`<td></td><td></td>${ggrCell(adjFor('pm'))}<td></td><td></td><td></td>${ggrCell(adjFor('py'))}<td></td>`}</tr></tfoot></table>`;
  }}

function bonusSort(rows,cols,txtKeys){
  let k=bSort.k, dir=bSort.dir;
  if(!k||!cols.some(c=>c.k===k)){k=cols[cols.length-1].k;dir=-1;}          // default: last col (cost) desc
  const txt=txtKeys.includes(k);
  rows.sort((a,b)=>{let x=a[k],y=b[k];if(x==null)x=txt?'':-1;if(y==null)y=txt?'':-1;return txt?(x>y?1:x<y?-1:0)*dir:(x-y)*dir;});
  return {k,dir};
}
function bonusHead(cols,active){return '<tr>'+cols.map(c=>`<th class="${c.cls||''} ${c.k===active?'sort':''}" data-bk="${c.k}">${c.lab}<span class="ar">▾</span></th>`).join('')+'</tr>';}
function bonusBind(){$('#bonusWrap').querySelectorAll('th[data-bk]').forEach(th=>th.onclick=()=>{const k=th.dataset.bk;const txt=(k==='d'||k==='grp'||k==='name');bSort.dir=bSort.k===k?-bSort.dir:(txt?1:-1);bSort.k=k;renderBonus();});}
function renderBonus(){const wrap=$('#bonusWrap'),sub=$('#bonusSub');
  if(selPlayer){
    let rows=BONUS.filter(r=>r.u===selPlayer).slice();
    const cols=[{k:'d',lab:'Date',cls:'l'},{k:'grp',lab:'Bonus Group',cls:'l'},{k:'name',lab:'Bonus Name',cls:'l'},{k:'n',lab:'Uses'},{k:'cost',lab:'Bonus Cost'}];
    const total=rows.reduce((s,x)=>s+x.cost,0),nuse=rows.reduce((s,x)=>s+x.n,0),ngrp=new Set(rows.map(r=>r.grp)).size;
    const act=bonusSort(rows,cols,['d','grp','name']);
    sub.innerHTML=`Bonus usage for <b style="color:var(--ink)">${selPlayer}</b> · ${rows.length} entries · <button id="bClr" style="border:none;background:none;color:var(--accent);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;cursor:pointer">clear</button>`;
    if(!rows.length){wrap.innerHTML='<div style="padding:18px 14px;color:var(--mut);font-size:13px">No bonus usage recorded for this player.</div>';}
    else{wrap.innerHTML=`<table><thead>${bonusHead(cols,act.k)}</thead>
      <tbody>${rows.map(r=>`<tr><td class="l">${dLabel(r.d)}</td><td class="l" style="font-size:12px">${r.grp}</td><td class="l" style="font-size:12px">${r.name}</td><td>${r.n}</td><td class="money-c">${r.cost?fmtM(r.cost):'<span class=zero>$0</span>'}</td></tr>`).join('')}</tbody>
      <tfoot><tr><td class="l" colspan="3">Total · ${ngrp} groups</td><td>${nuse}</td><td>${fmtM(total)}</td></tr></tfoot></table>`;bonusBind();}
    const c=$('#bClr');if(c)c.onclick=()=>{selPlayer=null;renderTop50();renderGames();renderFunnel();renderBonus();};
  }else{
    let src=BONUS.filter(r=>(!selDay||r.d===selDay)&&(!selCtry||r.c===selCtry)&&(!selAff||PAFF[r.u]===selAff));
    const m={};src.forEach(r=>{const k=r.grp+'|'+r.name;let o=m[k];if(!o)o=m[k]={grp:r.grp,name:r.name,cost:0,n:0,pl:new Set()};o.cost+=r.cost;o.n+=r.n;o.pl.add(r.u);});
    let rows=Object.values(m).map(o=>({grp:o.grp,name:o.name,cost:o.cost,n:o.n,players:o.pl.size}));
    const cols=[{k:'grp',lab:'Bonus Group',cls:'l'},{k:'name',lab:'Bonus Name',cls:'l'},{k:'players',lab:'Players'},{k:'n',lab:'Uses'},{k:'cost',lab:'Total Cost'}];
    const act=bonusSort(rows,cols,['grp','name']);
    const scope=(selDay||selCtry)?' ('+[selCtry,selDay?dLabel(selDay):null].filter(Boolean).join(' · ')+')':'';
    sub.innerHTML=`Bonus groups &amp; names used${scope} · <b>click a depositor above</b> to see their detail`;
    const tc=rows.reduce((s,x)=>s+x.cost,0),tn=rows.reduce((s,x)=>s+x.n,0);
    if(!rows.length){wrap.innerHTML='<div style="padding:18px 14px;color:var(--mut);font-size:13px">No bonus usage for this selection.</div>';return;}
    wrap.innerHTML=`<table><thead>${bonusHead(cols,act.k)}</thead>
      <tbody>${rows.map(r=>`<tr><td class="l" style="font-size:12px">${r.grp}</td><td class="l" style="font-size:12px">${r.name}</td><td>${fmtN(r.players)}</td><td>${fmtN(r.n)}</td><td class="money-c">${r.cost?fmtM(r.cost):'<span class=zero>$0</span>'}</td></tr>`).join('')}</tbody>
      <tfoot><tr><td class="l" colspan="2">${rows.length} bonuses</td><td></td><td>${fmtN(tn)}</td><td>${fmtM(tc)}</td></tr></tfoot></table>`;bonusBind();
  }}

function renderDailyCharts(){
var _rw=group(filt30({}).filter(function(r){return gfRow(r.ch,r.src,r.pay,r.fav);}),['fd']);var _mp={};_rw.forEach(function(r){_mp[r.fd]=r;});
var _rm=regMap30(function(x){return (!selCtry||x.c===selCtry)&&!gfNoReg()&&gfRow(x.ch,x.src);},function(x){return x.d;});
var _ck=DAYS30.map(function(d){var day=DATA.clk30[d];if(!day||gfNoReg()||selCtry)return null;var t=0;Object.keys(day).forEach(function(a){if(selAff&&a!==selAff)return;var m=DATA.affmeta[a];if(!gfRow(m?m[0]:null,m?m[1]:null))return;t+=day[a];});return t;});
var dd=DAYS30.map(function(d,i){return Object.assign({fd:d,f:0,sq:0,m:0,dep:0,ngr:0,adj:0,avg:0},_mp[d]||{},{reg:_rm[d]||0,clk:_ck[i],c2r:(_ck[i]&&_rm[d])?(_rm[d]/_ck[i]*100):null});});
dd.forEach(function(d){d.r2d=d.reg?d.f/d.reg*100:0;});var days=dd.map(function(d){return d.fd;});
var defs=[{k:'reg',lab:'Registrations',col:'var(--aff)',fmt:function(v){return fmtN(v);},sm:function(){var t=0;dd.forEach(function(d){t+=d.reg;});return 'total '+fmtN(t);}},
{k:'f',lab:'FTD',col:'var(--accent)',fmt:function(v){return fmtN(v);},sm:function(){var t=0;dd.forEach(function(d){t+=d.f;});return 'total '+fmtN(t);}},
{k:'r2d',lab:'Reg2Dep',col:'var(--sq)',fmt:function(v){return pctW(v);},sm:function(){var r=0,f=0;dd.forEach(function(d){r+=d.reg;f+=d.f;});return 'overall '+pctW(r?f/r*100:0);}},
{k:'avg',lab:'Avg FTD',col:'var(--money)',fmt:function(v){return '$'+fmtN(Math.round(v));},sm:function(){var m=0,f=0;dd.forEach(function(d){m+=d.m;f+=d.f;});return 'overall $'+(f?fmtN(Math.round(m/f)):'0');}},
{k:'clk',lab:'Clicks',col:'var(--stream)',fmt:function(v){return fmtN(v);},sm:function(){var t=0,any=0;dd.forEach(function(d){if(d.clk!=null){t+=d.clk;any=1;}});return any?'total '+fmtN(t):'no data';}},
{k:'c2r',lab:'Click2Reg',col:'var(--ret)',fmt:function(v){return pctW(v);},sm:function(){var c=0,r=0;dd.forEach(function(d){if(d.clk!=null){c+=d.clk;r+=d.reg;}});return c?'overall '+pctW(r/c*100):'no data';}}];
var W=640,H=150,pL=44,pR=14,pT=16,pB=22,pw=W-pL-pR,ph=H-pT-pB,n=dd.length;window.__dc=[];
var html=defs.map(function(d,ci){var raw=dd.map(function(r){return r[d.k];});var st=0;while(st<n&&raw[st]==null)st++;if(st>=n)st=n-1;var vals=raw.map(function(v){return +v||0;});var mx=(Math.max.apply(null,vals.slice(st))||1)*1.15;
var X=function(i){return pL+(n<=1?pw/2:i/(n-1)*pw);};var Y=function(v){return pT+(1-v/mx)*ph;};
var pts=[];for(var pi=st;pi<n;pi++)pts.push(X(pi).toFixed(1)+','+Y(vals[pi]).toFixed(1));
var area='M'+X(st).toFixed(1)+','+(pT+ph)+' L'+pts.join(' L')+' L'+X(n-1).toFixed(1)+','+(pT+ph)+' Z';
var g='<line x1='+pL+' y1='+(pT+ph)+' x2='+(W-pR)+' y2='+(pT+ph)+' stroke="var(--line)" stroke-width="1"/>';
var dots='';for(var i=st;i<n;i++){dots+='<circle cx='+X(i).toFixed(1)+' cy='+Y(vals[i]).toFixed(1)+' r="1.7" fill="'+d.col+'" fill-opacity="0.5"/>';}
var lx=X(n-1),ly=Y(vals[n-1]);var last='<circle cx='+lx.toFixed(1)+' cy='+ly.toFixed(1)+' r="3.4" fill="'+d.col+'"/><text x='+(lx-5).toFixed(1)+' y='+(ly-7).toFixed(1)+' text-anchor="end" font-size="10.5" font-weight="700" fill="'+d.col+'">'+d.fmt(vals[n-1])+'</text>';
var xt='';var step=Math.ceil(n/7);for(var j=0;j<n;j+=step){xt+='<text x='+X(j).toFixed(1)+' y='+(H-6)+' text-anchor="middle" font-size="8.5" fill="var(--mut)">'+dLab30(days[j])+'</text>';}
var y0='<text x='+(pL-6)+' y='+(pT+ph+3)+' text-anchor="end" font-size="9" fill="var(--mut)">0</text><text x='+(pL-6)+' y='+(pT+4)+' text-anchor="end" font-size="9" fill="var(--mut)">'+d.fmt(mx/1.15)+'</text>';
window.__dc.push({vals:vals,days:days,pL:pL,pw:pw,pT:pT,ph:ph,mx:mx,n:n,fmt:d.fmt});
var svg='<svg viewBox="0 0 '+W+' '+H+'" width="100%" style="display:block;overflow:visible" data-ci='+ci+'>'+g+'<path d="'+area+'" fill="'+d.col+'" fill-opacity="0.09"/><polyline points="'+pts.join(' ')+'" fill="none" stroke="'+d.col+'" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>'+dots+y0+'<line class="dc-cross" y1='+pT+' y2='+(pT+ph)+' stroke="var(--ink2)" stroke-width="1" stroke-dasharray="3,3" style="display:none"/><circle class="dc-hdot" r="4" fill="'+d.col+'" stroke="#fff" stroke-width="1.5" style="display:none"/>'+last+xt+'</svg>';
return '<div class="dchart"><div class="dchart-hd"><span style="color:'+d.col+'">\u25cf</span> '+d.lab+' <b>'+d.sm()+'</b></div><div class="dchart-body" style="position:relative">'+svg+'<div class="dchart-tip" style="position:absolute;display:none"></div></div></div>';}).join('');
$('#dailyCharts').innerHTML=html;
document.querySelectorAll('#dailyCharts svg').forEach(function(svg){var m=window.__dc[+svg.getAttribute('data-ci')];var cross=svg.querySelector('.dc-cross');var hd=svg.querySelector('.dc-hdot');var tip=svg.parentNode.querySelector('.dchart-tip');
svg.addEventListener('mousemove',function(e){var r=svg.getBoundingClientRect();var vbx=(e.clientX-r.left)*(640/r.width);var i=Math.round((vbx-m.pL)/m.pw*(m.n-1));if(i<0)i=0;if(i>m.n-1)i=m.n-1;var px=m.pL+(m.n<=1?m.pw/2:i/(m.n-1)*m.pw);var py=m.pT+(1-m.vals[i]/m.mx)*m.ph;cross.setAttribute('x1',px);cross.setAttribute('x2',px);cross.style.display='';hd.setAttribute('cx',px);hd.setAttribute('cy',py);hd.style.display='';tip.style.display='';tip.style.left=(px/640*r.width)+'px';tip.style.top=(py/150*r.height)+'px';tip.innerHTML=dLab30(m.days[i])+' \u00b7 '+m.fmt(m.vals[i]);});
svg.addEventListener('mouseleave',function(){cross.style.display='none';hd.style.display='none';tip.style.display='none';});});
if(!window.__dcBound){window.__dcBound=1;
var _srcs={};U.concat(U30).forEach(function(r){if(r.src&&r.src!=='SEO'&&r.src!=='Community')_srcs[r.src]=(_srcs[r.src]||0)+r.f;});
var _ord=Object.keys(_srcs).sort(function(a,b){return _srcs[b]-_srcs[a];});
var _favs={};U.concat(U30).forEach(function(r){var f=r.fav||'';if(f)_favs[f]=(_favs[f]||0)+r.f;});
var _fsw=document.getElementById('dcFavSwitch');
if(_fsw){_fsw.innerHTML='<button class="dcbtn on" data-p="">All products</button>'+Object.keys(_favs).sort(function(a,b){return _favs[b]-_favs[a];}).map(function(f){return '<button class="dcbtn" data-p="'+f+'">'+f+'</button>';}).join('');}
document.querySelectorAll('#dcFavSwitch .dcbtn').forEach(function(bt){bt.onclick=function(){window.__dcFav=bt.getAttribute('data-p')||null;document.querySelectorAll('#dcFavSwitch .dcbtn').forEach(function(x){x.classList.remove('on');});bt.classList.add('on');gfApply();};});
var _ssw=document.getElementById('dcSrcSwitch');
if(_ssw){_ssw.innerHTML='<button class="dcbtn on" data-src="">All sources</button>'+_ord.map(function(s){return '<button class="dcbtn" data-src="'+s+'">'+s+'</button>';}).join('');}
var _clr=function(sel,attr){document.querySelectorAll(sel+' .dcbtn').forEach(function(x){x.classList.toggle('on',x.getAttribute(attr)==='');});};
document.querySelectorAll('#dcSwitch .dcbtn').forEach(function(bt){bt.onclick=function(){window.__dcCh=bt.getAttribute('data-ch')||null;window.__dcSrc=null;document.querySelectorAll('#dcSwitch .dcbtn').forEach(function(x){x.classList.remove('on');});bt.classList.add('on');_clr('#dcSrcSwitch','data-src');gfApply();};});
document.querySelectorAll('#dcRailSwitch .dcbtn').forEach(function(bt){bt.onclick=function(){window.__dcRail=bt.getAttribute('data-y')||null;document.querySelectorAll('#dcRailSwitch .dcbtn').forEach(function(x){x.classList.remove('on');});bt.classList.add('on');gfApply();};});
document.querySelectorAll('#dcSrcSwitch .dcbtn').forEach(function(bt){bt.onclick=function(){window.__dcSrc=bt.getAttribute('data-src')||null;window.__dcCh=null;document.querySelectorAll('#dcSrcSwitch .dcbtn').forEach(function(x){x.classList.remove('on');});bt.classList.add('on');_clr('#dcSwitch','data-ch');gfApply();};});}
}
function gfApply(){GAMES=DATA.games.filter(r=>gfUser(r.u));BONUS=DATA.bonus.filter(r=>gfUser(r.u));ADJ=DATA.gameadj.filter(r=>gfUser(r.u));renderAll();window.__gfHooks.forEach(function(f){f();});}
function renderAll(){renderBar();renderKpis();renderKpis2();renderStripDaily();renderDailyCharts();renderTop50();renderGames();renderFunnel();renderBonus();
  window.__dayHooks.forEach(function(f){f();});
  $('#fRows').textContent=[selAff,selCtry||'all countries',selDay?dLabel(selDay):'all days'].filter(Boolean).join(' · ');}
hookSort('#dailyTbl',S.daily,['fd'],renderStripDaily);
renderAll();
</script>
<script>
(function(){
  var secs=[].slice.call(document.querySelectorAll('.sec'));
  secs.forEach(function(sec){
    var head=sec.querySelector('.sec-head');
    if(!head)return;
    var body=document.createElement('div');
    body.className='sec-body';
    var n=head.nextSibling;
    while(n){var nx=n.nextSibling;body.appendChild(n);n=nx;}
    sec.appendChild(body);
    var tog=document.createElement('button');
    tog.className='sec-tog';tog.textContent='+';
    tog.setAttribute('aria-label','expand section');
    sec.classList.add('closed');
    var titleWrap=head.firstElementChild;
    var title=head.querySelector('.sec-title');
    if(title)title.parentNode.insertBefore(tog,title);else head.insertBefore(tog,head.firstChild);
    if(title&&title.parentNode)title.parentNode.style.display='flex',title.parentNode.style.alignItems='center';
    head.addEventListener('click',function(e){
      if(e.target.closest('button')&&e.target!==tog)return;
      if(e.target.closest('a'))return;
      var closed=sec.classList.toggle('closed');
      tog.textContent=closed?'+':'\u2212';
      tog.setAttribute('aria-label',(closed?'expand':'collapse')+' section');
    });
  });
  var bar=document.createElement('div');bar.className='secbar';
  var all=document.createElement('button');all.id='secAll';all.textContent='expand all';
  bar.appendChild(all);
  var first=document.querySelector('.sec');
  if(first)first.parentNode.insertBefore(bar,first);
  all.onclick=function(){
    var anyOpen=secs.some(function(x){return !x.classList.contains('closed');});
    secs.forEach(function(x){
      x.classList.toggle('closed',anyOpen);
      var t=x.querySelector('.sec-tog');
      if(t)t.textContent=anyOpen?'+':'\u2212';
    });
    all.textContent=anyOpen?'expand all':'collapse all';
  };
})();
</script></body></html>