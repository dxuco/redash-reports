","a","SEO",1],["25","Bangladesh","d","d","",4],["25","Spain","seo","a","SEO",3],["25","Canada","seo","a","SEO",14],["25","Poland","d","d","",6],["25","Peru","d","d","",5],["25","France","d","d","",4],["25","Hong Kong","d","d","",1],["25","United Kingdom","d","d","",1],["25","Philippines","d","d","",2],["25","Thailand","d","d","",1],["25","United Kingdom","seo","a","SEO",4],["25","South Africa","d","d","",25],["25","Canada","d","d","",12],["25","Ukraine","d","d","",3],["25","South Sudan","d","d","",1],["25","Australia","d","d","",4],["25","Malta","seo","a","SEO",1],["25","Norway","d","d","",2],["25","Slovakia","d","d","",2],["25","Saudi Arabia","seo","a","SEO",3],["25","Kazakhstan","d","d","",1],["25","Belgium","seo","a","SEO",1],["25","Lithuania","d","d","",2],["25","Vietnam","seo","a","SEO",1],["25","Lebanon","d","d","",1],["25","Kosovo","d","d","",1],["25","Guam","seo","a","SEO",1],["25","India","d","d","",2],["25","Romania","d","d","",2],["25","Tanzania","d","d","",1],["25","Hungary","seo","a","SEO",3],["25","Slovenia","d","d","",1],["25","Algeria","a","a","PPC",1],["25","Brazil","seo","a","SEO",1],["25","Sweden","d","d","",2],["25","Estonia","d","d","",1],["25","Canada","a","a","PPC",1],["25","Romania","seo","a","SEO",3],["25","Netherlands","d","d","",2],["25","Philippines","seo","a","SEO",1],["25","South Africa","a","a","Uncategorized",1],["25","Algeria","d","d","",1],["25","Indonesia","seo","a","SEO",2],["25","Slovakia","seo","a","SEO",1],["25","Spain","d","d","",2],["25","Brazil","d","d","",4],["25","Australia","seo","a","SEO",7],["25","France","seo","a","SEO",1],["25","Denmark","d","d","",2],["25","Czechia","seo","a","SEO",3],["25","Malaysia","d","d","",1],["25","Taiwan","d","d","",1],["25","Russia","d","d","",1],["25","Ireland","d","d","",1],["25","Mexico","a","a","Uncategorized",1],["25","Ireland","seo","a","SEO",1],["25","NZ","d","d","",2],["25","Sweden","seo","a","SEO",2],["25","Hungary","d","d","",5],["25","Indonesia","d","d","",2],["25","South Korea","seo","a","SEO",1],["25","Namibia","d","d","",1],["25","Moldova","d","d","",1],["25","Madagascar","seo","a","SEO",1],["25","Italy","seo","a","SEO",1],["25","Venezuela","d","d","",3],["25","Uzbekistan","d","d","",1],["25","Bosnia & Herz.","d","d","",1],["25","Egypt","d","d","",1],["25","Ethiopia","d","d","",2],["25","Zambia","d","d","",1],["25","Armenia","seo","a","SEO",1],["25","Papua New Guinea","d","d","",1],["25","Serbia","d","d","",1],["25","Denmark","seo","a","SEO",1],["25","Angola","d","d","",1],["25","Switzerland","seo","a","SEO",1],["25","US","a","a","PPC",1],["25","Poland","seo","a","SEO",1],["25","Morocco","d","d","",1],["25","Kuwait","d","d","",1],["25","Gabon","d","d","",1],["25","Chile","d","d","",1],["25","Argentina","d","d","",1]]};
(function(){
  const SEP='border-left:2px solid #D8DEE0;';
  const fN=n=>Math.round(n).toLocaleString('en-US');
  const fG=n=>{n=Math.round(n);return (n<0?'-':'')+'$'+Math.abs(n).toLocaleString('en-US');};
  const fK=n=>{n=Math.round(n);const s=n<0?'-':'',a=Math.abs(n);if(a>=1000000)return s+'$'+(a/1000000).toFixed(a>=10000000?0:1).replace(/\.0$/,'')+'M';if(a>=1000)return s+'$'+(a/1000).toFixed(a>=100000?0:1).replace(/\.0$/,'')+'K';return s+'$'+a.toLocaleString('en-US');};
  const avg=v=>v[0]?v[3]/v[0]:0;
  const pct=(c,p)=>{if(!p)return '<span class="zero">\u2014</span>';const v=Math.round((c-p)/Math.abs(p)*100);const cls=v>=0?'pos':'neg';const a=Math.abs(v);const t=a>=10000?(a/1000).toFixed(0)+'K':a.toLocaleString('en-US');return '<span class="'+cls+'">'+(v===0?'0%':(v>0?'+':'-')+t+'%')+'</span>';};
  const val4=(m,c,f)=>{const v=m[c]||[0,0,0,0];return '<td style="'+(f?SEP:'')+'text-align:right">'+fN(v[0])+'</td><td style="text-align:right">'+fN(v[1])+'</td><td style="text-align:right">'+fG(avg(v))+'</td><td style="text-align:right">'+fG(v[2])+'</td>';};
  const pct4=(cu,pr,c,f)=>{const a=cu[c]||[0,0,0,0],b=pr[c]||[0,0,0,0];return '<td style="'+(f?SEP:'')+'text-align:right">'+pct(a[0],b[0])+'</td><td style="text-align:right">'+pct(a[1],b[1])+'</td><td style="text-align:right">'+pct(avg(a),avg(b))+'</td><td style="text-align:right">'+pct(a[2],b[2])+'</td>';};
  const fN2=n=>Math.round(n).toLocaleString('en-US');
  const DASH='<span class="zero">\u2014</span>';
  function val5(rg,m,c,hide){const v=m[c]||[0,0,0,0];const rr=rg[c]||0;
    return '<td style="'+SEP+'text-align:right">'+(hide?DASH:fN2(rr))+'</td>'+
      '<td style="text-align:right">'+fN2(v[0])+'</td>'+
      '<td style="text-align:right">'+((hide||!rr)?DASH:pctW(v[0]/rr*100))+'</td>'+
      '<td style="text-align:right">'+fN2(v[1])+'</td>'+
      '<td style="text-align:right">'+fG(avg(v))+'</td><td style="text-align:right">'+fK(v[2])+'</td>';}
  /* absolute FTD movement -- a percentage hides how small the base was, and
     "+2,800%" on three FTDs is not the same news as "+84" on eighty */
  function dcell(d,lead){return '<td style="'+(lead?SEP:'')+'text-align:right;font-weight:600">'+
    (d===0?DASH:'<span class="'+(d>0?'pos':'neg')+'">'+(d>0?'+':'−')+fN2(Math.abs(d))+'</span>')+'</td>';}
  function del2(mc,mp,my,c){const a=(mc[c]||[0])[0],b=(mp[c]||[0])[0],y=(my[c]||[0])[0];
    return dcell(a-b,1)+dcell(a-y,0);}
  function pct5(ra,rb,ma,mb,c,hide,g){const a=ma[c]||[0,0,0,0],b=mb[c]||[0,0,0,0];const K=' class="g'+g+'"';
    return '<td'+K+' style="'+SEP+'text-align:right">'+(hide?DASH:pct(ra[c]||0,rb[c]||0))+'</td>'+
      '<td'+K+' style="text-align:right">'+pct(a[0],b[0])+'</td><td'+K+' style="text-align:right">'+pct(a[1],b[1])+'</td>'+
      '<td'+K+' style="text-align:right">'+pct(avg(a),avg(b))+'</td><td'+K+' style="text-align:right">'+pct(a[2],b[2])+'</td>';}
  const cpCh=new Set();let cpPr='all',cpRl='all';
  const cpSort={k:'cur.f',dir:-1};
  const CPLAB={s:'Streamer',a:'Affiliate',seo:'SEO',d:'Direct',com:'Community'};
  const RLAB={c:'Crypto',f:'Fiat'};
  /* See the partner table for why this is a day number and not a date. */
  const cpDay=()=>(window.__selDayOf&&window.__selDayOf())||null;
  function aggregate(list,D){const m={};
    list.forEach(function(r){
      if(D&&r.d!==D)return;
      if(!gfRow(r.h,r.k,r.y,r.p))return;
      if(cpCh.size&&!cpCh.has(r.g))return;
      if(cpPr!=='all'&&r.p!==cpPr)return;
      if(cpRl!=='all'&&r.y!==cpRl)return;
      let v=m[r.c];if(!v)v=m[r.c]=[0,0,0,0];v[0]+=1;v[1]+=r.s;v[2]+=r.a;v[3]+=r.m;});
    return m;}
  function regOf(per){const src=CPR[per];
    const gs=window.__dcSrc||null,gc=window.__dcCh||null;
    if(gs)return src['@'+gs]||{};
    if(gc)return src[gc]||{};
    if(!cpCh.size)return src.all||{};
    const out={};cpCh.forEach(function(g){const mm=src[g]||{};
      Object.keys(mm).forEach(function(c){out[c]=(out[c]||0)+mm[c];});});
    return out;}
  function regDayOf(per,D){const rows=CPRD[per]||[];
    const gs=window.__dcSrc||null,gc=window.__dcCh||null;
    const out={};
    for(let i=0;i<rows.length;i++){const r=rows[i];
      if(r[0]!==D)continue;
      if(gs){if(r[4]!==gs)continue;}
      else if(gc){if(r[2]!==gc)continue;}
      else if(cpCh.size&&!cpCh.has(r[2]))continue;
      out[r[1]]=(out[r[1]]||0)+r[5];}
    return out;}
  window.__gfHooks.push(render);
  window.__dayHooks.push(render);
  function render(){
    const D=cpDay();
    const cur=aggregate(CPP.cur,D),pm=aggregate(CPP.pm,D),py=aggregate(CPP.py,D);
    const rc=D?regDayOf('cur',D):regOf('cur'),rp=D?regDayOf('pm',D):regOf('pm'),ry=D?regDayOf('py',D):regOf('py');
    const hide=(cpPr!=='all'||cpRl!=='all'||gfNoReg());
    const P3={cur:[rc,cur],pm:[rp,pm],py:[ry,py]};
    const mOf=(pair,c,m)=>{if(m==='reg')return pair[0][c]||0;const v=pair[1][c]||[0,0,0,0];
      if(m==='r2d'){const r=pair[0][c]||0;return r?v[0]/r*100:0;}
      return m==='f'?v[0]:m==='sq'?v[1]:m==='avg'?avg(v):v[2];};
    const chg=(a,b)=>b?(a-b)/Math.abs(b)*100:-Infinity;
    let sk=cpSort.k;
    if(hide&&sk.split('.')[1]==='reg')sk='cur.f';
    const sv=c=>{const q=sk.split('.'),g=q[0],m=q[1];
      if(g==='mom')return chg(mOf(P3.cur,c,m),mOf(P3.pm,c,m));
      if(g==='yoy')return chg(mOf(P3.cur,c,m),mOf(P3.py,c,m));
      if(g==='d')return mOf(P3.cur,c,'f')-mOf(m==='dmom'?P3.pm:P3.py,c,'f');
      return mOf(P3[g],c,m);};
    const cand=[...new Set([...Object.keys(cur),...Object.keys(pm),...Object.keys(py),
      ...(hide?[]:[...Object.keys(rc),...Object.keys(rp),...Object.keys(ry)])])];
    const top=cand.sort((x,y)=>{const a=sv(x),b=sv(y);
      return a===b?(x<y?-1:1):(a-b)*cpSort.dir;}).slice(0,20);
    document.querySelectorAll('th.cph').forEach(th=>th.classList.toggle('sorted',th.dataset.sk===sk));
    document.getElementById('cpBody').innerHTML=top.length?top.map(c=>'<tr><td class="l">'+c+'</td>'+val5(rc,cur,c,hide)+val5(rp,pm,c,hide)+pct5(rc,rp,cur,pm,c,hide,'mom')+val5(ry,py,c,hide)+pct5(rc,ry,cur,py,c,hide,'yoy')+del2(cur,pm,py,c)+'</tr>').join('')
      :'<tr><td class="l" colspan="31" style="color:var(--mut);padding:16px 12px">No FTDs for this selection.</td></tr>';
    const allc=new Set([...Object.keys(cur),...Object.keys(pm),...Object.keys(py)]);
    const sum=m=>{let t=[0,0,0,0];allc.forEach(c=>{const v=m[c]||[0,0,0,0];t[0]+=v[0];t[1]+=v[1];t[2]+=v[2];t[3]+=v[3];});return t;};
    const T={t:sum(cur)},P={t:sum(pm)},Y={t:sum(py)};
    const rsum=m=>{let n=0;Object.keys(m).forEach(k=>n+=m[k]);return n;};
    const RC={t:rsum(rc)},RP={t:rsum(rp)},RY={t:rsum(ry)};
    document.getElementById('cpFoot').innerHTML='<tr style="font-weight:700;border-top:2px solid #C3CCD4"><td class="l"><b>Total</b></td>'+val5(RC,T,'t',hide)+val5(RP,P,'t',hide)+pct5(RC,RP,T,P,'t',hide,'mom')+val5(RY,Y,'t',hide)+pct5(RC,RY,T,Y,'t',hide,'yoy')+del2(T,P,Y,'t')+'</tr>';
    const sc=document.getElementById('cpScope');
    if(sc){const parts=[];
      if(D)parts.push('day '+Number(D)+' of each period');
      if(cpCh.size)parts.push([...cpCh].map(g=>CPLAB[g]).join(' + '));
      if(cpPr!=='all')parts.push(cpPr);
      if(cpRl!=='all')parts.push(RLAB[cpRl]);
      sc.textContent=parts.length?parts.join(' \u00b7 ')+' \u00b7 '+T.t[0]+' FTDs':T.t[0]+' FTDs';}
  }
  function paintCh(){document.querySelectorAll('#cpSwitch .cpbtn').forEach(function(x){
    const k=x.dataset.ch;x.classList.toggle('on',k==='all'?cpCh.size===0:cpCh.has(k));});}
  document.querySelectorAll('#cpSwitch .cpbtn').forEach(b=>b.onclick=()=>{
    const k=b.dataset.ch;
    if(k==='all')cpCh.clear();
    else if(cpCh.has(k))cpCh.delete(k);else cpCh.add(k);
    paintCh();render();});
  document.querySelectorAll('#cpProd .cpp').forEach(b=>b.onclick=()=>{
    document.querySelectorAll('#cpProd .cpp').forEach(x=>x.classList.remove('on'));
    b.classList.add('on');cpPr=b.dataset.p;render();});
  document.querySelectorAll('#cpRail .cpp').forEach(b=>b.onclick=()=>{
    document.querySelectorAll('#cpRail .cpp').forEach(x=>x.classList.remove('on'));
    b.classList.add('on');cpRl=b.dataset.y;render();});
  document.querySelectorAll('th.cph').forEach(th=>th.onclick=()=>{
    const k=th.dataset.sk;
    cpSort.dir=cpSort.k===k?-cpSort.dir:-1;cpSort.k=k;render();});

  /* Collapse a whole comparison block. The group header stays as a one-cell
     stub with a + so the block can be brought back, and its colspan drops to 1
     so the two header rows stay aligned with the body. */
  (function(){
    const tbl=document.getElementById('cpTbl');
    if(!tbl)return;
    tbl.querySelectorAll('th.grp').forEach(function(th){
      const g=th.dataset.g, span=+th.dataset.span;
      const btn=document.createElement('button');
      btn.className='colTog';btn.textContent='−';
      btn.setAttribute('aria-label','hide '+g+' columns');
      btn.onclick=function(e){e.stopPropagation();
        const off=tbl.classList.toggle('no'+g);
        th.colSpan=off?1:span;
        btn.textContent=off?'+':'−';
        btn.setAttribute('aria-label',(off?'show ':'hide ')+g+' columns');
        const lab=th.querySelector('.grplab');if(lab)lab.style.display=off?'none':'';};
      th.appendChild(btn);});
  })();
  render();
})();
</script>
<div class="sec"><div class="sec-head"><div><span class="sec-title"><span class="sec-num">06</span>Partner Performance &mdash; MoM &amp; YoY</span><span class="sec-sub" id="apScope" style="margin-left:10px"></span></div></div><div class="sec-sub">Top 30 partners by current-month FTDs &middot; click column headers to sort &middot; channel buttons combine (click several) &middot; <span id="apPeriodNote">all periods month-to-date (days 1&ndash;25)</span> &middot; MoM vs July 2026 &middot; YoY vs August 2025</div><style>
#apSwitch .apbtn{padding:4px 13px;border:1px solid #C3CCD4;background:#fff;border-radius:6px;cursor:pointer;
  font-family:inherit;font-size:12px;font-weight:600;color:#5B7285}
#apSwitch .apbtn.on{background:#0B6E3A;color:#fff;border-color:#0B6E3A}
#apProd .app,#apRail .app{padding:4px 13px;border:1px solid #C3CCD4;background:#fff;border-radius:6px;cursor:pointer;
  font-family:inherit;font-size:12px;font-weight:600;color:#5B7285}
#apProd .app.on{background:#4E9D5C;color:#fff;border-color:#4E9D5C}
#apRail .app.on{background:#E67E22;color:#fff;border-color:#E67E22}
#apRail .app[data-y="c"].on{background:#0B6E3A;border-color:#0B6E3A}
.apscroll{overflow-x:auto}
#apTbl{width:auto;min-width:auto}
#apTbl td{padding:2.5px 4px;white-space:nowrap;font-size:10.5px;line-height:1.25}
#apTbl th{padding:4px 4px;font-size:8.5px}
#apTbl td.l,#apTbl th.l{max-width:130px;overflow:hidden;text-overflow:ellipsis}
#apTbl td.l{font-size:11px}
#apTbl thead th{position:static}
#apTbl tfoot td{position:static;padding:4px 4px}
th.aph{cursor:pointer;user-select:none;white-space:nowrap}
th.aph:hover{color:var(--ink)}
th.aph .apar{opacity:.2;font-size:7px;margin-left:1px}
