<div class="sec" id="kpiBlock"><div class="sec-head"><div><span class="sec-title"><span class="sec-num">01</span>General</span></div><div class="sec-sub fbar" id="fbar"></div></div>
<div id="scoreWrap">
<div class="scgrid">
  <div class="scstack">
    <div class="sccol"><div class="sccap">Acquisition</div><div class="scscroll"><table class="sctbl" id="scAcq"></table></div></div>
    <div class="sccol"><div class="sccap">Retention &amp; Quality</div><div class="scscroll"><table class="sctbl" id="scRet"></table></div></div>
  </div>
  <div class="sccol"><div class="sccap">Finance</div><div class="scscroll"><table class="sctbl" id="scFin"></table></div></div>
</div></div>
<style>
/* Finance has ten rows to Acquisition's four, so the two short tables stack in
   one column against it rather than leaving half a screen of white space. */
.scgrid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:26px;margin-top:4px}
@media(max-width:1000px){.scgrid{grid-template-columns:minmax(0,1fr)}}
.scstack{display:flex;flex-direction:column;gap:24px;min-width:0}
/* without min-width:0 a grid item refuses to go below its content width, and
   the widest table spills over the one next to it instead of scrolling */
.sccol{min-width:0}
.scscroll{overflow-x:auto}
.sccap{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--accent);font-weight:600;margin:0 0 7px}
.sctbl{width:100%;border-collapse:collapse;font-size:12px}
.sctbl th{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:8.5px;letter-spacing:.06em;text-transform:uppercase;
  color:var(--mut);font-weight:600;text-align:right;padding:0 7px 6px;border-bottom:1px solid var(--line);white-space:nowrap}
.sctbl th.l{text-align:left}
.sctbl td{padding:4.5px 6px;text-align:right;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;white-space:nowrap;
  border-bottom:1px solid var(--line2)}
.sctbl td.l{text-align:left;font-family:inherit;font-weight:600}
.sctbl td.cur{font-weight:700;font-size:13px}
.sctbl td.dim{color:var(--mut)}
.sctbl tr:last-child td{border-bottom:none}
.scup{color:#0F2A43}.scdn{color:#E67E22}
</style>
