# Copy this to config.env in the project folder and fill in the key.

REDASH_HOST=https://redash.veis.tech

# One API key per query. Find it in Redash: open the query, "..." menu,
# Show API Key. The key only unlocks that one query, which is why there is
# a separate line per query rather than one account-wide key.
#
#   1732 = Marketing General Report
#   1731 = Bonus Cost By Categories
REDASH_KEY_1732=
# REDASH_KEY_1731=

# Which query export-csv.js exports by default.
CSV_QUERY=1732

# Where to write the CSV. Point this at wherever the project already reads
# its exported file from, and nothing else in that project needs to change.
CSV_OUT=

# How many days back to export when no date range is given.
# Leave empty to export the current month so far.
CSV_DAYS=
